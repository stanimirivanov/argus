{
  "$id": "https://argus.dev/contracts/performance-mapping-policy/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "argus.dev/performance-mapping-policy/v1"
          ]
        }
      ]
    },
    "repository": {
      "$ref": "#/$defs/RepositoryIdentity"
    },
    "headRevision": {
      "$ref": "#/$defs/Revision"
    },
    "impactSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "catalogSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "reviewedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "reviewedAt": {
      "type": "string"
    },
    "expiresAt": {
      "type": "string"
    },
    "headCapabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LocalKey"
      },
      "maxItems": 5000
    },
    "allowedProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issuer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "issuer",
          "id",
          "revision",
          "sha256"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "deployments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "environment": {
            "type": "object",
            "properties": {
              "issuer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "issuer",
              "id",
              "revision",
              "sha256"
            ],
            "additionalProperties": false
          },
          "reference": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "issuer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "issuer",
                  "id",
                  "revision",
                  "sha256"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "service": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "issuer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [
                  "issuer",
                  "id"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "imageSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "sourceRevision": {
            "$ref": "#/$defs/Revision"
          }
        },
        "required": [
          "environment",
          "reference",
          "service",
          "imageSha256",
          "sourceRevision"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "capability": {
            "$ref": "#/$defs/LocalKey"
          },
          "workload": {
            "type": "object",
            "properties": {
              "issuer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "issuer",
              "id",
              "revision",
              "sha256"
            ],
            "additionalProperties": false
          },
          "profile": {
            "type": "object",
            "properties": {
              "issuer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "issuer",
              "id",
              "revision",
              "sha256"
            ],
            "additionalProperties": false
          },
          "environment": {
            "type": "object",
            "properties": {
              "issuer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "issuer",
              "id",
              "revision",
              "sha256"
            ],
            "additionalProperties": false
          },
          "policy": {
            "type": "object",
            "properties": {
              "issuer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "issuer",
              "id",
              "revision",
              "sha256"
            ],
            "additionalProperties": false
          },
          "baseline": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "issuer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "issuer",
                  "id",
                  "revision",
                  "sha256"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "capability",
          "workload",
          "profile",
          "environment",
          "policy",
          "baseline"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    }
  },
  "required": [
    "apiVersion",
    "repository",
    "headRevision",
    "impactSha256",
    "catalogSha256",
    "reviewId",
    "reviewedBy",
    "reviewedAt",
    "expiresAt",
    "headCapabilities",
    "allowedProfiles",
    "deployments",
    "mappings"
  ],
  "additionalProperties": false,
  "$defs": {
    "RepositoryIdentity": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "provider",
        "host",
        "providerRepositoryId"
      ],
      "additionalProperties": false,
      "description": "A repository identity that remains stable across ordinary renames and transfers."
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha1"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha256"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    },
    "LocalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration."
    }
  }
}
