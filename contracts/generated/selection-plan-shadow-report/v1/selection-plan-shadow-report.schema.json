{
  "$id": "https://argus.dev/contracts/selection-plan-shadow-report/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SelectionPlanShadowReportV1": {
      "type": "object",
      "required": [
        "apiVersion",
        "plan",
        "manifest",
        "groupCount",
        "groupsWithSelection",
        "fullOnlyGroupCount",
        "selectedTestCount",
        "fullSuiteTestCount",
        "selectedDurationMs",
        "fullSuiteDurationMs",
        "durationReductionMs",
        "selectedFailureCount",
        "fullSuiteFailureCount",
        "caughtFullSuiteFailureCount",
        "failureRecallBasisPoints",
        "groups"
      ],
      "properties": {
        "apiVersion": {
          "type": "string",
          "enum": [
            "argus.dev/selection-plan-shadow-report/v1"
          ]
        },
        "plan": {
          "type": "object",
          "required": [
            "apiVersion",
            "sha256"
          ],
          "properties": {
            "apiVersion": {
              "type": "string",
              "enum": [
                "argus.dev/functional-api-execution-plan/v1"
              ]
            },
            "sha256": {
              "type": "string",
              "description": "a string matching the pattern ^[0-9a-f]{64}$",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "manifest": {
          "type": "object",
          "required": [
            "apiVersion",
            "sha256"
          ],
          "properties": {
            "apiVersion": {
              "type": "string",
              "enum": [
                "argus.dev/execution-manifest/v1"
              ]
            },
            "sha256": {
              "type": "string",
              "description": "a string matching the pattern ^[0-9a-f]{64}$",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "groupCount": {
          "$ref": "#/$defs/Int",
          "description": "a number less than or equal to 10000",
          "title": "lessThanOrEqualTo(10000)",
          "minimum": 0,
          "maximum": 10000
        },
        "groupsWithSelection": {
          "$ref": "#/$defs/Int",
          "description": "a number less than or equal to 10000",
          "title": "lessThanOrEqualTo(10000)",
          "minimum": 0,
          "maximum": 10000
        },
        "fullOnlyGroupCount": {
          "$ref": "#/$defs/Int",
          "description": "a number less than or equal to 10000",
          "title": "lessThanOrEqualTo(10000)",
          "minimum": 0,
          "maximum": 10000
        },
        "selectedTestCount": {
          "$ref": "#/$defs/Int",
          "description": "a number less than or equal to 10000",
          "title": "lessThanOrEqualTo(10000)",
          "minimum": 0,
          "maximum": 10000
        },
        "fullSuiteTestCount": {
          "$ref": "#/$defs/Int",
          "description": "a number less than or equal to 10000",
          "title": "lessThanOrEqualTo(10000)",
          "minimum": 0,
          "maximum": 10000
        },
        "selectedDurationMs": {
          "$ref": "#/$defs/Int",
          "description": "a number less than or equal to 864000000000",
          "title": "lessThanOrEqualTo(864000000000)",
          "minimum": 0,
          "maximum": 864000000000
        },
        "fullSuiteDurationMs": {
          "$ref": "#/$defs/Int",
          "description": "a number less than or equal to 864000000000",
          "title": "lessThanOrEqualTo(864000000000)",
          "minimum": 0,
          "maximum": 864000000000
        },
        "durationReductionMs": {
          "$ref": "#/$defs/Int",
          "description": "a number less than or equal to 864000000000",
          "title": "lessThanOrEqualTo(864000000000)",
          "minimum": -864000000000,
          "maximum": 864000000000
        },
        "selectedFailureCount": {
          "$ref": "#/$defs/Int",
          "description": "a number less than or equal to 10000",
          "title": "lessThanOrEqualTo(10000)",
          "minimum": 0,
          "maximum": 10000
        },
        "fullSuiteFailureCount": {
          "$ref": "#/$defs/Int",
          "description": "a number less than or equal to 10000",
          "title": "lessThanOrEqualTo(10000)",
          "minimum": 0,
          "maximum": 10000
        },
        "caughtFullSuiteFailureCount": {
          "$ref": "#/$defs/Int",
          "description": "a number less than or equal to 10000",
          "title": "lessThanOrEqualTo(10000)",
          "minimum": 0,
          "maximum": 10000
        },
        "failureRecallBasisPoints": {
          "anyOf": [
            {
              "$ref": "#/$defs/Int",
              "description": "a number less than or equal to 10000",
              "title": "lessThanOrEqualTo(10000)",
              "minimum": 0,
              "maximum": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "groupKey",
              "testRepository",
              "testRevision",
              "adapter",
              "selectedAttemptId",
              "fullSuiteAttemptId",
              "selectedTestCount",
              "fullSuiteTestCount",
              "selectedDurationMs",
              "fullSuiteDurationMs",
              "durationReductionMs",
              "selectedFailureCount",
              "fullSuiteFailureCount",
              "caughtFullSuiteFailureCount",
              "failureRecallBasisPoints",
              "missedFailures"
            ],
            "properties": {
              "groupKey": {
                "$ref": "#/$defs/LocalKey"
              },
              "testRepository": {
                "$ref": "#/$defs/RepositoryReference"
              },
              "testRevision": {
                "$ref": "#/$defs/Revision"
              },
              "adapter": {
                "type": "object",
                "required": [
                  "id",
                  "version"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/LocalKey"
                  },
                  "version": {
                    "type": "string",
                    "description": "a string at most 127 character(s) long",
                    "title": "maxLength(127)",
                    "minLength": 1,
                    "maxLength": 127
                  }
                },
                "additionalProperties": false
              },
              "selectedAttemptId": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "a string matching the pattern ^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                    "title": "maxLength(127)",
                    "minLength": 1,
                    "maxLength": 127,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "fullSuiteAttemptId": {
                "type": "string",
                "description": "a string matching the pattern ^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                "title": "maxLength(127)",
                "minLength": 1,
                "maxLength": 127,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "selectedTestCount": {
                "$ref": "#/$defs/Int",
                "description": "a number less than or equal to 10000",
                "title": "lessThanOrEqualTo(10000)",
                "minimum": 0,
                "maximum": 10000
              },
              "fullSuiteTestCount": {
                "$ref": "#/$defs/Int",
                "description": "a number less than or equal to 10000",
                "title": "lessThanOrEqualTo(10000)",
                "minimum": 0,
                "maximum": 10000
              },
              "selectedDurationMs": {
                "$ref": "#/$defs/Int",
                "description": "a number less than or equal to 864000000000",
                "title": "lessThanOrEqualTo(864000000000)",
                "minimum": 0,
                "maximum": 864000000000
              },
              "fullSuiteDurationMs": {
                "$ref": "#/$defs/Int",
                "description": "a number less than or equal to 864000000000",
                "title": "lessThanOrEqualTo(864000000000)",
                "minimum": 0,
                "maximum": 864000000000
              },
              "durationReductionMs": {
                "$ref": "#/$defs/Int",
                "description": "a number less than or equal to 864000000000",
                "title": "lessThanOrEqualTo(864000000000)",
                "minimum": -864000000000,
                "maximum": 864000000000
              },
              "selectedFailureCount": {
                "$ref": "#/$defs/Int",
                "description": "a number less than or equal to 10000",
                "title": "lessThanOrEqualTo(10000)",
                "minimum": 0,
                "maximum": 10000
              },
              "fullSuiteFailureCount": {
                "$ref": "#/$defs/Int",
                "description": "a number less than or equal to 10000",
                "title": "lessThanOrEqualTo(10000)",
                "minimum": 0,
                "maximum": 10000
              },
              "caughtFullSuiteFailureCount": {
                "$ref": "#/$defs/Int",
                "description": "a number less than or equal to 10000",
                "title": "lessThanOrEqualTo(10000)",
                "minimum": 0,
                "maximum": 10000
              },
              "failureRecallBasisPoints": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Int",
                    "description": "a number less than or equal to 10000",
                    "title": "lessThanOrEqualTo(10000)",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "missedFailures": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "suiteKey",
                    "testKey",
                    "fullSuiteOutcome",
                    "selectedOutcome",
                    "reason"
                  ],
                  "properties": {
                    "suiteKey": {
                      "$ref": "#/$defs/LocalKey"
                    },
                    "testKey": {
                      "$ref": "#/$defs/LocalKey"
                    },
                    "fullSuiteOutcome": {
                      "type": "string",
                      "enum": [
                        "failed",
                        "error"
                      ]
                    },
                    "selectedOutcome": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "passed",
                            "failed",
                            "skipped",
                            "error"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "enum": [
                        "not-selected",
                        "not-reproduced"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "description": "an array of at most 10000 item(s)",
                "title": "maxItems(10000)",
                "maxItems": 10000
              }
            },
            "additionalProperties": false
          },
          "description": "an array of at most 10000 item(s)",
          "title": "maxItems(10000)",
          "maxItems": 10000
        }
      },
      "additionalProperties": false,
      "description": "Aggregate duration and failure-recall evidence for every group in one immutable execution plan.",
      "title": "Argus selection plan shadow report v1"
    },
    "Int": {
      "type": "integer",
      "description": "an integer",
      "title": "int"
    },
    "LocalKey": {
      "type": "string",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration.",
      "title": "maxLength(63)",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "RepositoryReference": {
      "type": "object",
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "description": "a string matching the pattern ^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "description": "a string at most 255 character(s) long",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "description": "a string at most 255 character(s) long",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "description": "a string at most 255 character(s) long",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "algorithm",
            "digest"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "git-sha1"
              ]
            },
            "digest": {
              "type": "string",
              "description": "a string matching the pattern ^[0-9a-f]{40}$",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "algorithm",
            "digest"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "git-sha256"
              ]
            },
            "digest": {
              "type": "string",
              "description": "a string matching the pattern ^[0-9a-f]{64}$",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    }
  },
  "$ref": "#/$defs/SelectionPlanShadowReportV1"
}
