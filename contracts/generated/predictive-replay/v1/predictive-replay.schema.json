{
  "$id": "https://argus.dev/contracts/predictive-replay/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PredictiveReplayV1",
  "$defs": {
    "LocalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration."
    },
    "PredictiveReplayV1": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/predictive-replay/v1"
              ]
            }
          ]
        },
        "holdoutStart": {
          "type": "string"
        },
        "holdoutEnd": {
          "type": "string"
        },
        "trainCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "holdoutCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "excludedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "episodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/LocalKey"
              },
              "featureCutoffAt": {
                "type": "string"
              },
              "observationSha256": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "minItems": 1,
                "maxItems": 100
              },
              "split": {
                "type": "string",
                "enum": [
                  "train",
                  "holdout",
                  "excluded"
                ]
              },
              "exclusionReason": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "control-after-training-cutoff",
                      "outside-holdout-window"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "history": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/LocalKey"
                },
                "maxItems": 1000
              }
            },
            "required": [
              "id",
              "featureCutoffAt",
              "observationSha256",
              "split",
              "exclusionReason",
              "history"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 1000
        }
      },
      "required": [
        "apiVersion",
        "holdoutStart",
        "holdoutEnd",
        "trainCount",
        "holdoutCount",
        "excludedCount",
        "episodes"
      ],
      "additionalProperties": false,
      "title": "Argus predictive replay v1"
    }
  }
}
