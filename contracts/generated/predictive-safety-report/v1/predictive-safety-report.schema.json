{
  "$id": "https://argus.dev/contracts/predictive-safety-report/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "argus.dev/predictive-safety-report/v1"
          ]
        }
      ]
    },
    "inputSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "windowStart": {
      "type": "string"
    },
    "windowEnd": {
      "type": "string"
    },
    "asOf": {
      "type": "string"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "runId": {
            "$ref": "#/$defs/LocalKey"
          },
          "episodeId": {
            "$ref": "#/$defs/LocalKey"
          },
          "groupKey": {
            "$ref": "#/$defs/LocalKey"
          },
          "mode": {
            "type": "string",
            "enum": [
              "shadow",
              "staged"
            ]
          },
          "schedule": {
            "type": "object",
            "properties": {
              "apiVersion": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "apiVersion",
              "sha256"
            ],
            "additionalProperties": false
          },
          "manifest": {
            "type": "object",
            "properties": {
              "apiVersion": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "apiVersion",
              "sha256"
            ],
            "additionalProperties": false
          },
          "planSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "policyVersion": {
            "type": "string"
          },
          "testRepository": {
            "$ref": "#/$defs/RepositoryReference"
          },
          "testRevision": {
            "$ref": "#/$defs/Revision"
          },
          "discoverySha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "featureCutoffAt": {
            "type": "string"
          },
          "calibrationCutoffAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "adapter": {
            "$ref": "#/$defs/LocalKey"
          },
          "project": {
            "type": "string"
          },
          "environment": {
            "$ref": "#/$defs/LocalKey"
          },
          "calibration": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "apiVersion": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "apiVersion",
                  "sha256"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "modelSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "baselineEce": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "Infinity",
                      "-Infinity",
                      "NaN"
                    ]
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "complete",
              "pending",
              "incomplete"
            ]
          },
          "candidateCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "earlyCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "unknownLabels": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "family": {
            "type": "string",
            "enum": [
              "functional-api",
              "functional-ui"
            ]
          },
          "selectionRate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "enum": [
                  "Infinity",
                  "-Infinity",
                  "NaN"
                ]
              }
            ]
          },
          "failures": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "caughtFailures": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "recall": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "Infinity",
                      "-Infinity",
                      "NaN"
                    ]
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "brier": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "Infinity",
                      "-Infinity",
                      "NaN"
                    ]
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "ece": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "Infinity",
                      "-Infinity",
                      "NaN"
                    ]
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "eceDrift": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "Infinity",
                      "-Infinity",
                      "NaN"
                    ]
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "firstFailureMs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "phases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "stage": {
                  "type": "string",
                  "enum": [
                    "relevant-now",
                    "remaining-later",
                    "shadow-control"
                  ]
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "complete",
                    "pending",
                    "late",
                    "empty",
                    "incomplete"
                  ]
                },
                "attemptId": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "startedAt": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "completedAt": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "durationMs": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "elapsedMs": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "estimatedDurationMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "estimatedResourceUnitMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "stage",
                "state",
                "attemptId",
                "startedAt",
                "completedAt",
                "durationMs",
                "elapsedMs",
                "estimatedDurationMs",
                "estimatedResourceUnitMs"
              ],
              "additionalProperties": false
            },
            "minItems": 2,
            "maxItems": 2
          },
          "misses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "suiteKey": {
                  "$ref": "#/$defs/LocalKey"
                },
                "testKey": {
                  "$ref": "#/$defs/LocalKey"
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "not-selected",
                    "not-reproduced-early"
                  ]
                }
              },
              "required": [
                "id",
                "suiteKey",
                "testKey",
                "reason"
              ],
              "additionalProperties": false
            },
            "maxItems": 10000
          },
          "unavailable": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20
          }
        },
        "required": [
          "runId",
          "episodeId",
          "groupKey",
          "mode",
          "schedule",
          "manifest",
          "planSha256",
          "policyVersion",
          "testRepository",
          "testRevision",
          "discoverySha256",
          "featureCutoffAt",
          "calibrationCutoffAt",
          "adapter",
          "project",
          "environment",
          "calibration",
          "modelSha256",
          "baselineEce",
          "state",
          "candidateCount",
          "earlyCount",
          "unknownLabels",
          "family",
          "selectionRate",
          "failures",
          "caughtFailures",
          "recall",
          "brier",
          "ece",
          "eceDrift",
          "firstFailureMs",
          "phases",
          "misses",
          "unavailable"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "cohorts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "providerRepositoryId": {
            "type": "string"
          },
          "family": {
            "type": "string",
            "enum": [
              "functional-api",
              "functional-ui"
            ]
          },
          "selectionRate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "enum": [
                  "Infinity",
                  "-Infinity",
                  "NaN"
                ]
              }
            ]
          },
          "failures": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "caughtFailures": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "recall": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "Infinity",
                      "-Infinity",
                      "NaN"
                    ]
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "groups": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "completeGroups": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "candidates": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "early": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "provider",
          "host",
          "providerRepositoryId",
          "family",
          "selectionRate",
          "failures",
          "caughtFailures",
          "recall",
          "groups",
          "completeGroups",
          "candidates",
          "early"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "unavailable": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 20
    }
  },
  "required": [
    "apiVersion",
    "inputSha256",
    "windowStart",
    "windowEnd",
    "asOf",
    "groups",
    "cohorts",
    "unavailable"
  ],
  "additionalProperties": false,
  "$defs": {
    "LocalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration."
    },
    "RepositoryReference": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha1"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha256"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    }
  }
}
