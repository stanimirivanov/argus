{
  "$id": "https://argus.dev/contracts/predictive-promotion-decision/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "argus.dev/predictive-promotion-decision/v1"
          ]
        }
      ]
    },
    "policySha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "replaySha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "shadowIndexSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scheduleSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "modelSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "calibrationSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository": {
      "$ref": "#/$defs/RepositoryReference"
    },
    "family": {
      "type": "string",
      "enum": [
        "functional-api",
        "functional-ui"
      ]
    },
    "evaluatedAt": {
      "type": "string"
    },
    "expiresAt": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "shadow",
        "staged"
      ]
    },
    "remainingRequired": {
      "anyOf": [
        {
          "type": "boolean",
          "enum": [
            true
          ]
        }
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LocalKey"
      },
      "maxItems": 30
    },
    "replay": {
      "type": "object",
      "properties": {
        "samples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "misses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missRate": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "enum": [
                    "Infinity",
                    "-Infinity",
                    "NaN"
                  ]
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "samples",
        "failures",
        "misses",
        "missRate"
      ],
      "additionalProperties": false
    },
    "shadow": {
      "type": "object",
      "properties": {
        "samples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "misses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missRate": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "enum": [
                    "Infinity",
                    "-Infinity",
                    "NaN"
                  ]
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "samples",
        "failures",
        "misses",
        "missRate"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "policySha256",
    "replaySha256",
    "shadowIndexSha256",
    "scheduleSha256",
    "modelSha256",
    "calibrationSha256",
    "repository",
    "family",
    "evaluatedAt",
    "expiresAt",
    "mode",
    "remainingRequired",
    "reasons",
    "replay",
    "shadow"
  ],
  "additionalProperties": false,
  "$defs": {
    "RepositoryReference": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "LocalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration."
    }
  }
}
