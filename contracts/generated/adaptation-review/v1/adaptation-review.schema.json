{
  "$id": "https://argus.dev/contracts/adaptation-review/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AdaptationReviewV1": {
      "type": "object",
      "required": [
        "apiVersion",
        "reviewId",
        "proposalId",
        "validationId",
        "repository",
        "provider",
        "base",
        "head",
        "pullRequest",
        "publishedAt"
      ],
      "properties": {
        "apiVersion": {
          "type": "string",
          "enum": [
            "argus.dev/adaptation-review/v1"
          ]
        },
        "reviewId": {
          "type": "string",
          "description": "a string matching the pattern ^[0-9a-f]{64}$",
          "pattern": "^[0-9a-f]{64}$"
        },
        "proposalId": {
          "type": "string",
          "description": "a string matching the pattern ^[0-9a-f]{64}$",
          "pattern": "^[0-9a-f]{64}$"
        },
        "validationId": {
          "type": "string",
          "description": "a string matching the pattern ^[0-9a-f]{64}$",
          "pattern": "^[0-9a-f]{64}$"
        },
        "repository": {
          "$ref": "#/$defs/RepositoryReference"
        },
        "provider": {
          "type": "string",
          "enum": [
            "github"
          ]
        },
        "base": {
          "type": "object",
          "required": [
            "branch",
            "revision"
          ],
          "properties": {
            "branch": {
              "type": "string",
              "description": "a string at most 255 character(s) long",
              "title": "maxLength(255)",
              "minLength": 1,
              "maxLength": 255
            },
            "revision": {
              "$ref": "#/$defs/Revision"
            }
          },
          "additionalProperties": false
        },
        "head": {
          "type": "object",
          "required": [
            "branch",
            "revision"
          ],
          "properties": {
            "branch": {
              "type": "string",
              "description": "a string at most 255 character(s) long",
              "title": "maxLength(255)",
              "minLength": 1,
              "maxLength": 255
            },
            "revision": {
              "$ref": "#/$defs/Revision"
            }
          },
          "additionalProperties": false
        },
        "pullRequest": {
          "type": "object",
          "required": [
            "number",
            "url",
            "draft",
            "state"
          ],
          "properties": {
            "number": {
              "$ref": "#/$defs/Int",
              "description": "a number greater than or equal to 1",
              "title": "greaterThanOrEqualTo(1)",
              "minimum": 1
            },
            "url": {
              "type": "string",
              "description": "a string at most 2048 character(s) long",
              "title": "maxLength(2048)",
              "minLength": 1,
              "maxLength": 2048
            },
            "draft": {
              "type": "boolean",
              "enum": [
                true
              ]
            },
            "state": {
              "type": "string",
              "enum": [
                "open"
              ]
            }
          },
          "additionalProperties": false
        },
        "publishedAt": {
          "$ref": "#/$defs/DateTimeUtc"
        }
      },
      "additionalProperties": false,
      "description": "An open draft pull request published from one correlated proposal and successful validation proof.",
      "title": "Argus adaptation review v1"
    },
    "RepositoryReference": {
      "type": "object",
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "description": "a string matching the pattern ^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "description": "a string at most 255 character(s) long",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "description": "a string at most 255 character(s) long",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "description": "a string at most 255 character(s) long",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "algorithm",
            "digest"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "git-sha1"
              ]
            },
            "digest": {
              "type": "string",
              "description": "a string matching the pattern ^[0-9a-f]{40}$",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "algorithm",
            "digest"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "git-sha256"
              ]
            },
            "digest": {
              "type": "string",
              "description": "a string matching the pattern ^[0-9a-f]{64}$",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    },
    "Int": {
      "type": "integer",
      "description": "an integer",
      "title": "int"
    },
    "DateTimeUtc": {
      "type": "string",
      "description": "a string to be decoded into a DateTime.Utc"
    }
  },
  "$ref": "#/$defs/AdaptationReviewV1"
}
