{
  "$id": "https://argus.dev/contracts/adaptation-review/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/AdaptationReviewV1",
  "$defs": {
    "RepositoryReference": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha1"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha256"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    },
    "AdaptationReviewV1": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/adaptation-review/v1"
              ]
            }
          ]
        },
        "reviewId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "proposalId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "validationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "repository": {
          "$ref": "#/$defs/RepositoryReference"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "github"
              ]
            }
          ]
        },
        "base": {
          "type": "object",
          "properties": {
            "branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "revision": {
              "$ref": "#/$defs/Revision"
            }
          },
          "required": [
            "branch",
            "revision"
          ],
          "additionalProperties": false
        },
        "head": {
          "type": "object",
          "properties": {
            "branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "revision": {
              "$ref": "#/$defs/Revision"
            }
          },
          "required": [
            "branch",
            "revision"
          ],
          "additionalProperties": false
        },
        "pullRequest": {
          "type": "object",
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "draft": {
              "anyOf": [
                {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              ]
            },
            "state": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "open"
                  ]
                }
              ]
            }
          },
          "required": [
            "number",
            "url",
            "draft",
            "state"
          ],
          "additionalProperties": false
        },
        "publishedAt": {
          "type": "string"
        }
      },
      "required": [
        "apiVersion",
        "reviewId",
        "proposalId",
        "validationId",
        "repository",
        "provider",
        "base",
        "head",
        "pullRequest",
        "publishedAt"
      ],
      "additionalProperties": false,
      "title": "Argus adaptation review v1",
      "description": "An open draft pull request published from one correlated proposal and successful validation proof."
    }
  }
}
