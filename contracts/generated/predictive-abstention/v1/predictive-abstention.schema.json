{
  "$id": "https://argus.dev/contracts/predictive-abstention/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PredictiveAbstentionV1",
  "$defs": {
    "LocalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration."
    },
    "PredictiveAbstentionV1": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/predictive-abstention/v1"
              ]
            }
          ]
        },
        "calibrationVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/predictive-calibration/v1"
              ]
            }
          ]
        },
        "minimumBinExamples": {
          "type": "integer",
          "maximum": 9007199254740991,
          "exclusiveMinimum": 0
        },
        "fitEpisodeIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocalKey"
          },
          "maxItems": 1000
        },
        "calibrationEpisodeIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocalKey"
          },
          "maxItems": 1000
        },
        "episodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/LocalKey"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "eligible",
                  "full-control"
                ]
              },
              "evidenceState": {
                "type": "string",
                "enum": [
                  "calibrated",
                  "unavailable"
                ]
              },
              "candidateTestIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "minItems": 1,
                "maxItems": 10000
              },
              "requiredTestIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "maxItems": 10000
              },
              "tests": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "repositoryKey": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "family": {
                      "type": "string",
                      "enum": [
                        "functional-api",
                        "functional-ui"
                      ]
                    },
                    "probability": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "enum": [
                            "Infinity",
                            "-Infinity",
                            "NaN"
                          ]
                        }
                      ]
                    },
                    "calibrationSource": {
                      "type": "string",
                      "enum": [
                        "cohort",
                        "global"
                      ]
                    },
                    "priorControls": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "cohortExamples": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "calibrationBin": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9
                    },
                    "binExamples": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "reasons": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "cold-start",
                          "global-calibration",
                          "sparse-calibration-bin"
                        ]
                      },
                      "maxItems": 3
                    }
                  },
                  "required": [
                    "id",
                    "repositoryKey",
                    "family",
                    "probability",
                    "calibrationSource",
                    "priorControls",
                    "cohortExamples",
                    "calibrationBin",
                    "binExamples",
                    "reasons"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 10000
              }
            },
            "required": [
              "id",
              "mode",
              "evidenceState",
              "candidateTestIds",
              "requiredTestIds",
              "tests"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 1000
        }
      },
      "required": [
        "apiVersion",
        "calibrationVersion",
        "minimumBinExamples",
        "fitEpisodeIds",
        "calibrationEpisodeIds",
        "episodes"
      ],
      "additionalProperties": false,
      "title": "Argus predictive abstention evaluation v1"
    }
  }
}
