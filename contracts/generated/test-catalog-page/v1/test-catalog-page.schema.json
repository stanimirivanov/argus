{
  "$id": "https://argus.dev/contracts/test-catalog-page/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/TestCatalogPageV1",
  "$defs": {
    "RepositoryReference": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha1"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha256"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    },
    "CatalogSnapshotReference": {
      "type": "object",
      "properties": {
        "sourceRepository": {
          "$ref": "#/$defs/RepositoryReference"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "descriptorApiVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/repository-descriptor/v1"
              ]
            }
          ]
        }
      },
      "required": [
        "sourceRepository",
        "revision",
        "descriptorApiVersion"
      ],
      "additionalProperties": false,
      "description": "The immutable repository descriptor observation queried by this result page."
    },
    "LocalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration."
    },
    "TestFamily": {
      "type": "string",
      "enum": [
        "unit",
        "component",
        "contract",
        "integration",
        "functional-api",
        "functional-ui",
        "end-to-end",
        "performance",
        "security",
        "resilience",
        "other"
      ]
    },
    "CapabilityReference": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/LocalKey"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "key",
        "name"
      ],
      "additionalProperties": false
    },
    "TestCatalogEntry": {
      "type": "object",
      "properties": {
        "testRepository": {
          "$ref": "#/$defs/RepositoryReference"
        },
        "suite": {
          "type": "object",
          "properties": {
            "key": {
              "$ref": "#/$defs/LocalKey"
            },
            "family": {
              "$ref": "#/$defs/TestFamily"
            },
            "adapter": {
              "type": "string",
              "minLength": 1,
              "maxLength": 127
            }
          },
          "required": [
            "key",
            "family",
            "adapter"
          ],
          "additionalProperties": false
        },
        "test": {
          "type": "object",
          "properties": {
            "key": {
              "$ref": "#/$defs/LocalKey"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          },
          "required": [
            "key",
            "name"
          ],
          "additionalProperties": false
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityReference"
          },
          "minItems": 1
        }
      },
      "required": [
        "testRepository",
        "suite",
        "test",
        "capabilities"
      ],
      "additionalProperties": false,
      "description": "A stable test identity and its immutable catalog metadata. Identity is testRepository identity plus suite.key plus test.key."
    },
    "ContinuationCursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "An opaque, versioned continuation token bound to the originating query."
    },
    "TestCatalogPageV1": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/test-catalog-page/v1"
              ]
            }
          ]
        },
        "snapshot": {
          "$ref": "#/$defs/CatalogSnapshotReference"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TestCatalogEntry"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContinuationCursor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "apiVersion",
        "snapshot",
        "items",
        "nextCursor"
      ],
      "additionalProperties": false,
      "title": "Argus test catalog page v1",
      "description": "A deterministic page of tests from one immutable catalog snapshot, ordered by stable test identity."
    }
  }
}
