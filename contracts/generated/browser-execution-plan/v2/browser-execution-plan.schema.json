{
  "$id": "https://argus.dev/contracts/browser-execution-plan/v2/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "argus.dev/browser-execution-plan/v2"
          ]
        }
      ]
    },
    "schedule": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/predictive-portfolio/v1"
              ]
            }
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "apiVersion",
        "sha256"
      ],
      "additionalProperties": false
    },
    "episodeId": {
      "$ref": "#/$defs/LocalKey"
    },
    "discoverySha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/browser-selection-manifest/v1"
              ]
            }
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "apiVersion",
        "sha256"
      ],
      "additionalProperties": false
    },
    "mode": {
      "type": "string",
      "enum": [
        "shadow",
        "staged"
      ]
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "groupKey": {
            "$ref": "#/$defs/LocalKey"
          },
          "testRepository": {
            "$ref": "#/$defs/RepositoryReference"
          },
          "testRevision": {
            "$ref": "#/$defs/Revision"
          },
          "adapter": {
            "$ref": "#/$defs/LocalKey"
          },
          "project": {
            "$ref": "#/$defs/LocalKey"
          },
          "environment": {
            "$ref": "#/$defs/LocalKey"
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "suiteKey": {
                  "$ref": "#/$defs/LocalKey"
                },
                "testKey": {
                  "$ref": "#/$defs/LocalKey"
                },
                "decision": {
                  "type": "string",
                  "enum": [
                    "RUN_REQUIRED",
                    "SKIP_FOR_NOW"
                  ]
                }
              },
              "required": [
                "id",
                "suiteKey",
                "testKey",
                "decision"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 10000
          },
          "relevantNow": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "maxItems": 10000
          },
          "remainingLater": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "maxItems": 10000
          }
        },
        "required": [
          "groupKey",
          "testRepository",
          "testRevision",
          "adapter",
          "project",
          "environment",
          "candidates",
          "relevantNow",
          "remainingLater"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000
    }
  },
  "required": [
    "apiVersion",
    "schedule",
    "episodeId",
    "discoverySha256",
    "manifest",
    "mode",
    "groups"
  ],
  "additionalProperties": false,
  "$defs": {
    "LocalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration."
    },
    "RepositoryReference": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha1"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha256"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    }
  }
}
