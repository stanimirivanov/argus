{
  "$id": "https://argus.dev/contracts/head-test-inventory/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/HeadTestInventoryV1",
  "$defs": {
    "RepositoryIdentity": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "provider",
        "host",
        "providerRepositoryId"
      ],
      "additionalProperties": false,
      "description": "A repository identity that remains stable across ordinary renames and transfers."
    },
    "RepositoryReference": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha1"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha256"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    },
    "LocalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration."
    },
    "HeadTestInventoryV1": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/head-test-inventory/v1"
              ]
            }
          ]
        },
        "sourceRepository": {
          "$ref": "#/$defs/RepositoryIdentity"
        },
        "complete": {
          "type": "boolean"
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "testRepository": {
                "$ref": "#/$defs/RepositoryReference"
              },
              "revision": {
                "$ref": "#/$defs/Revision"
              },
              "suiteKey": {
                "$ref": "#/$defs/LocalKey"
              },
              "adapter": {
                "type": "string",
                "minLength": 1,
                "maxLength": 127
              },
              "testKey": {
                "$ref": "#/$defs/LocalKey"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/LocalKey"
                },
                "maxItems": 5000
              },
              "new": {
                "type": "boolean"
              },
              "modified": {
                "type": "boolean"
              }
            },
            "required": [
              "testRepository",
              "revision",
              "suiteKey",
              "adapter",
              "testKey",
              "name",
              "capabilities",
              "new",
              "modified"
            ],
            "additionalProperties": false
          },
          "maxItems": 10000
        }
      },
      "required": [
        "apiVersion",
        "sourceRepository",
        "complete",
        "tests"
      ],
      "additionalProperties": false,
      "description": "Complete functional API discovery at immutable test-repository revisions."
    }
  }
}
