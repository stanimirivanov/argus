{
  "$id": "https://argus.dev/contracts/functional-api-adapter-request/v2/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "argus.dev/functional-api-adapter-request/v2"
          ]
        }
      ]
    },
    "attemptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 127,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "manifest": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "enum": [
            "argus.dev/execution-manifest/v1",
            "argus.dev/execution-manifest/v4"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "apiVersion",
        "sha256"
      ],
      "additionalProperties": false
    },
    "stage": {
      "type": "string",
      "enum": [
        "relevant-now",
        "remaining-later",
        "shadow-control"
      ]
    },
    "testRepository": {
      "$ref": "#/$defs/RepositoryReference"
    },
    "testRevision": {
      "$ref": "#/$defs/Revision"
    },
    "adapter": {
      "$ref": "#/$defs/LocalKey"
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "suiteKey": {
            "$ref": "#/$defs/LocalKey"
          },
          "testKey": {
            "$ref": "#/$defs/LocalKey"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": [
          "suiteKey",
          "testKey",
          "name"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "staging": {
      "type": "object",
      "properties": {
        "schedule": {
          "type": "object",
          "properties": {
            "apiVersion": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "argus.dev/predictive-portfolio/v1"
                  ]
                }
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "apiVersion",
            "sha256"
          ],
          "additionalProperties": false
        },
        "episodeId": {
          "$ref": "#/$defs/LocalKey"
        },
        "groupKey": {
          "$ref": "#/$defs/LocalKey"
        },
        "environment": {
          "$ref": "#/$defs/LocalKey"
        },
        "mode": {
          "type": "string",
          "enum": [
            "shadow",
            "staged"
          ]
        }
      },
      "required": [
        "schedule",
        "episodeId",
        "groupKey",
        "environment",
        "mode"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "attemptId",
    "manifest",
    "stage",
    "testRepository",
    "testRevision",
    "adapter",
    "tests",
    "staging"
  ],
  "additionalProperties": false,
  "$defs": {
    "RepositoryReference": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha1"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha256"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    },
    "LocalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration."
    }
  }
}
