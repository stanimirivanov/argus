{
  "$id": "https://argus.dev/contracts/adaptation-proposal/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AdaptationProposalV1": {
      "type": "object",
      "required": [
        "apiVersion",
        "policyVersion",
        "proposalId",
        "sourceImpact",
        "change",
        "test",
        "classification",
        "decision",
        "endpointRename",
        "adapter",
        "edit"
      ],
      "properties": {
        "apiVersion": {
          "type": "string",
          "enum": [
            "argus.dev/adaptation-proposal/v1"
          ]
        },
        "policyVersion": {
          "type": "string",
          "enum": [
            "argus.dev/adaptation-policy/functional-api-endpoint-rename/v1"
          ]
        },
        "proposalId": {
          "type": "string",
          "description": "a string matching the pattern ^[0-9a-f]{64}$",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceImpact": {
          "type": "object",
          "required": [
            "apiVersion",
            "analyzerVersion"
          ],
          "properties": {
            "apiVersion": {
              "type": "string",
              "enum": [
                "argus.dev/capability-impact/v1"
              ]
            },
            "analyzerVersion": {
              "type": "string",
              "enum": [
                "argus-openapi/v1+libopenapi/v0.38.7"
              ]
            }
          },
          "additionalProperties": false
        },
        "change": {
          "type": "object",
          "required": [
            "sourceRepository",
            "pullRequest",
            "baseRevision",
            "headRevision",
            "observedAt",
            "trigger"
          ],
          "properties": {
            "sourceRepository": {
              "$ref": "#/$defs/RepositoryReference"
            },
            "pullRequest": {
              "type": "object",
              "required": [
                "number"
              ],
              "properties": {
                "number": {
                  "$ref": "#/$defs/Int",
                  "description": "a number greater than or equal to 1",
                  "title": "greaterThanOrEqualTo(1)",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            },
            "baseRevision": {
              "$ref": "#/$defs/Revision"
            },
            "headRevision": {
              "$ref": "#/$defs/Revision"
            },
            "observedAt": {
              "$ref": "#/$defs/DateTimeUtc"
            },
            "trigger": {
              "type": "object",
              "required": [
                "provider",
                "deliveryId",
                "event",
                "action"
              ],
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": [
                    "github"
                  ]
                },
                "deliveryId": {
                  "type": "string",
                  "description": "a string at most 255 character(s) long",
                  "title": "maxLength(255)",
                  "minLength": 1,
                  "maxLength": 255
                },
                "event": {
                  "type": "string",
                  "enum": [
                    "pull_request"
                  ]
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "opened",
                    "reopened",
                    "synchronize",
                    "ready_for_review"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "test": {
          "type": "object",
          "required": [
            "repository",
            "revision",
            "suiteKey",
            "testKey",
            "name",
            "adapter",
            "capabilities"
          ],
          "properties": {
            "repository": {
              "$ref": "#/$defs/RepositoryReference"
            },
            "revision": {
              "$ref": "#/$defs/Revision"
            },
            "suiteKey": {
              "$ref": "#/$defs/LocalKey"
            },
            "testKey": {
              "$ref": "#/$defs/LocalKey"
            },
            "name": {
              "type": "string",
              "description": "a string at most 255 character(s) long",
              "title": "maxLength(255)",
              "minLength": 1,
              "maxLength": 255
            },
            "adapter": {
              "$ref": "#/$defs/LocalKey"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/LocalKey"
              },
              "description": "an array of at most 5000 item(s)",
              "title": "maxItems(5000)",
              "minItems": 1,
              "maxItems": 5000
            }
          },
          "additionalProperties": false
        },
        "classification": {
          "type": "string",
          "enum": [
            "INVALIDATED"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "PATCH_AND_VALIDATE"
          ]
        },
        "endpointRename": {
          "type": "object",
          "required": [
            "method",
            "operationId",
            "previousPath",
            "path",
            "capabilities"
          ],
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "GET",
                "PUT",
                "POST",
                "DELETE",
                "OPTIONS",
                "HEAD",
                "PATCH",
                "TRACE",
                "QUERY"
              ]
            },
            "operationId": {
              "type": "string",
              "description": "a string at most 255 character(s) long",
              "title": "maxLength(255)",
              "minLength": 1,
              "maxLength": 255
            },
            "previousPath": {
              "type": "string",
              "description": "a string matching the pattern ^\\/",
              "title": "maxLength(2048)",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^\\/"
            },
            "path": {
              "type": "string",
              "description": "a string matching the pattern ^\\/",
              "title": "maxLength(2048)",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^\\/"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/LocalKey"
              },
              "description": "an array of at most 50 item(s)",
              "title": "maxItems(50)",
              "minItems": 1,
              "maxItems": 50
            }
          },
          "additionalProperties": false
        },
        "adapter": {
          "type": "object",
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/LocalKey"
            },
            "version": {
              "type": "string",
              "description": "a string at most 127 character(s) long",
              "title": "maxLength(127)",
              "minLength": 1,
              "maxLength": 127
            }
          },
          "additionalProperties": false
        },
        "edit": {
          "type": "object",
          "required": [
            "path",
            "beforeSha256",
            "startByte",
            "endByte",
            "original",
            "replacement",
            "semanticRole"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "a string matching the pattern ^[^/\\\\][^\\\\]*$",
              "title": "maxLength(4096)",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^/\\\\][^\\\\]*$"
            },
            "beforeSha256": {
              "type": "string",
              "description": "a string matching the pattern ^[0-9a-f]{64}$",
              "pattern": "^[0-9a-f]{64}$"
            },
            "startByte": {
              "$ref": "#/$defs/Int",
              "description": "a non-negative number",
              "title": "greaterThanOrEqualTo(0)",
              "minimum": 0
            },
            "endByte": {
              "$ref": "#/$defs/Int",
              "description": "a non-negative number",
              "title": "greaterThanOrEqualTo(0)",
              "minimum": 0
            },
            "original": {
              "type": "string",
              "description": "a string matching the pattern ^\\/",
              "title": "maxLength(2048)",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^\\/"
            },
            "replacement": {
              "type": "string",
              "description": "a string matching the pattern ^\\/",
              "title": "maxLength(2048)",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^\\/"
            },
            "semanticRole": {
              "type": "string",
              "enum": [
                "request-target"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "A deterministic, reviewable request-target edit that still requires isolated validation.",
      "title": "Argus adaptation proposal v1"
    },
    "RepositoryReference": {
      "type": "object",
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "description": "a string matching the pattern ^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "description": "a string at most 255 character(s) long",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "description": "a string at most 255 character(s) long",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "description": "a string at most 255 character(s) long",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "Int": {
      "type": "integer",
      "description": "an integer",
      "title": "int"
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "algorithm",
            "digest"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "git-sha1"
              ]
            },
            "digest": {
              "type": "string",
              "description": "a string matching the pattern ^[0-9a-f]{40}$",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "algorithm",
            "digest"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "git-sha256"
              ]
            },
            "digest": {
              "type": "string",
              "description": "a string matching the pattern ^[0-9a-f]{64}$",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    },
    "DateTimeUtc": {
      "type": "string",
      "description": "a string to be decoded into a DateTime.Utc"
    },
    "LocalKey": {
      "type": "string",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration.",
      "title": "maxLength(63)",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$"
    }
  },
  "$ref": "#/$defs/AdaptationProposalV1"
}
