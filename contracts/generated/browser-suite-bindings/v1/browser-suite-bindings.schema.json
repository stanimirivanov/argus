{
  "$id": "https://argus.dev/contracts/browser-suite-bindings/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/BrowserSuiteBindingsV1",
  "$defs": {
    "RepositoryIdentity": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "provider",
        "host",
        "providerRepositoryId"
      ],
      "additionalProperties": false,
      "description": "A repository identity that remains stable across ordinary renames and transfers."
    },
    "LocalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration."
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha1"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha256"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    },
    "BrowserSuiteBindingsV1": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/browser-suite-bindings/v1"
              ]
            }
          ]
        },
        "sourceRepository": {
          "$ref": "#/$defs/RepositoryIdentity"
        },
        "suites": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "testRepository": {
                "$ref": "#/$defs/RepositoryIdentity"
              },
              "suiteKey": {
                "$ref": "#/$defs/LocalKey"
              },
              "revision": {
                "$ref": "#/$defs/Revision"
              }
            },
            "required": [
              "testRepository",
              "suiteKey",
              "revision"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 10000
        }
      },
      "required": [
        "apiVersion",
        "sourceRepository",
        "suites"
      ],
      "additionalProperties": false,
      "description": "Explicit immutable browser test checkout revisions selected by reviewed CI configuration."
    }
  }
}
