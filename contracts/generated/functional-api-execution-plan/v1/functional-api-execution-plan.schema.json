{
  "$id": "https://argus.dev/contracts/functional-api-execution-plan/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/FunctionalAPIExecutionPlanV1",
  "$defs": {
    "LocalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration."
    },
    "RepositoryReference": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha1"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha256"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    },
    "FunctionalAPIExecutionPlanV1": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/functional-api-execution-plan/v1"
              ]
            }
          ]
        },
        "manifest": {
          "type": "object",
          "properties": {
            "apiVersion": {
              "type": "string",
              "enum": [
                "argus.dev/execution-manifest/v1",
                "argus.dev/execution-manifest/v4"
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "apiVersion",
            "sha256"
          ],
          "additionalProperties": false
        },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "groupKey": {
                "$ref": "#/$defs/LocalKey"
              },
              "stage": {
                "type": "string",
                "enum": [
                  "selected",
                  "full-suite"
                ]
              },
              "testRepository": {
                "$ref": "#/$defs/RepositoryReference"
              },
              "testRevision": {
                "$ref": "#/$defs/Revision"
              },
              "adapter": {
                "$ref": "#/$defs/LocalKey"
              },
              "testCount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            },
            "required": [
              "groupKey",
              "stage",
              "testRepository",
              "testRevision",
              "adapter",
              "testCount"
            ],
            "additionalProperties": false
          },
          "maxItems": 20000
        }
      },
      "required": [
        "apiVersion",
        "manifest",
        "jobs"
      ],
      "additionalProperties": false,
      "title": "Argus functional API execution plan v1",
      "description": "Deterministic flattened selected and full-suite jobs for a CI matrix without executable commands."
    }
  }
}
