{
  "$id": "https://argus.dev/contracts/browser-discovery/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/BrowserDiscoveryV1",
  "$defs": {
    "LocalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration."
    },
    "RepositoryReference": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha1"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha256"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    },
    "CatalogSnapshotReference": {
      "type": "object",
      "properties": {
        "sourceRepository": {
          "$ref": "#/$defs/RepositoryReference"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "descriptorApiVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/repository-descriptor/v1"
              ]
            }
          ]
        }
      },
      "required": [
        "sourceRepository",
        "revision",
        "descriptorApiVersion"
      ],
      "additionalProperties": false,
      "description": "The immutable repository descriptor observation queried by this result page."
    },
    "RepositoryIdentity": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "provider",
        "host",
        "providerRepositoryId"
      ],
      "additionalProperties": false,
      "description": "A repository identity that remains stable across ordinary renames and transfers."
    },
    "BrowserDiscoveryV1": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/browser-discovery/v1"
              ]
            }
          ]
        },
        "observationId": {
          "$ref": "#/$defs/LocalKey"
        },
        "catalog": {
          "$ref": "#/$defs/CatalogSnapshotReference"
        },
        "collectorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 127
        },
        "collectedAt": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        },
        "complete": {
          "type": "boolean"
        },
        "mappingRevision": {
          "$ref": "#/$defs/Revision"
        },
        "mappingComplete": {
          "type": "boolean"
        },
        "suites": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "testRepository": {
                "$ref": "#/$defs/RepositoryReference"
              },
              "revision": {
                "$ref": "#/$defs/Revision"
              },
              "suiteKey": {
                "$ref": "#/$defs/LocalKey"
              },
              "cases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "testKey": {
                      "$ref": "#/$defs/LocalKey"
                    },
                    "project": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 127
                    },
                    "file": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255
                    },
                    "tags": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 127
                      },
                      "maxItems": 64
                    },
                    "owners": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 127
                      },
                      "maxItems": 64
                    }
                  },
                  "required": [
                    "testKey",
                    "project",
                    "file",
                    "title",
                    "tags",
                    "owners"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 10000
              }
            },
            "required": [
              "testRepository",
              "revision",
              "suiteKey",
              "cases"
            ],
            "additionalProperties": false
          },
          "maxItems": 10000
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "route",
                  "component"
                ]
              },
              "key": {
                "$ref": "#/$defs/LocalKey"
              },
              "routePattern": {
                "type": "string",
                "maxLength": 512
              },
              "sourceRoot": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "testRepository": {
                "$ref": "#/$defs/RepositoryIdentity"
              },
              "suiteKey": {
                "$ref": "#/$defs/LocalKey"
              },
              "testKey": {
                "$ref": "#/$defs/LocalKey"
              }
            },
            "required": [
              "kind",
              "key",
              "routePattern",
              "sourceRoot",
              "testRepository",
              "suiteKey",
              "testKey"
            ],
            "additionalProperties": false
          },
          "maxItems": 20000
        }
      },
      "required": [
        "apiVersion",
        "observationId",
        "catalog",
        "collectorVersion",
        "collectedAt",
        "expiresAt",
        "complete",
        "mappingRevision",
        "mappingComplete",
        "suites",
        "mappings"
      ],
      "additionalProperties": false,
      "description": "Immutable Playwright inventory and explicit route/component-to-test mapping evidence."
    }
  }
}
