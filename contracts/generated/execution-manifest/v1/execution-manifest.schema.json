{
  "$id": "https://argus.dev/contracts/execution-manifest/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ExecutionManifestV1": {
      "type": "object",
      "required": [
        "apiVersion",
        "policyVersion",
        "impact",
        "change",
        "catalog",
        "family",
        "mode",
        "affectedCapabilities",
        "uncoveredCapabilities",
        "decisions",
        "warnings"
      ],
      "properties": {
        "apiVersion": {
          "type": "string",
          "enum": [
            "argus.dev/execution-manifest/v1"
          ]
        },
        "policyVersion": {
          "type": "string",
          "enum": [
            "argus.dev/selection-policy/functional-api/v1"
          ]
        },
        "impact": {
          "type": "object",
          "required": [
            "apiVersion",
            "analyzerVersion"
          ],
          "properties": {
            "apiVersion": {
              "type": "string",
              "enum": [
                "argus.dev/capability-impact/v1"
              ]
            },
            "analyzerVersion": {
              "type": "string",
              "enum": [
                "argus-openapi/v1+libopenapi/v0.38.7"
              ]
            }
          },
          "additionalProperties": false
        },
        "change": {
          "type": "object",
          "required": [
            "sourceRepository",
            "pullRequest",
            "baseRevision",
            "headRevision",
            "observedAt",
            "trigger"
          ],
          "properties": {
            "sourceRepository": {
              "$ref": "#/$defs/RepositoryReference"
            },
            "pullRequest": {
              "type": "object",
              "required": [
                "number"
              ],
              "properties": {
                "number": {
                  "$ref": "#/$defs/Int",
                  "description": "a number greater than or equal to 1",
                  "title": "greaterThanOrEqualTo(1)",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            },
            "baseRevision": {
              "$ref": "#/$defs/Revision"
            },
            "headRevision": {
              "$ref": "#/$defs/Revision"
            },
            "observedAt": {
              "$ref": "#/$defs/DateTimeUtc"
            },
            "trigger": {
              "type": "object",
              "required": [
                "provider",
                "deliveryId",
                "event",
                "action"
              ],
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": [
                    "github"
                  ]
                },
                "deliveryId": {
                  "type": "string",
                  "description": "a string at most 255 character(s) long",
                  "title": "maxLength(255)",
                  "minLength": 1,
                  "maxLength": 255
                },
                "event": {
                  "type": "string",
                  "enum": [
                    "pull_request"
                  ]
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "opened",
                    "reopened",
                    "synchronize",
                    "ready_for_review"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "catalog": {
          "$ref": "#/$defs/CatalogSnapshotReference"
        },
        "family": {
          "type": "string",
          "enum": [
            "functional-api"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "targeted",
            "fallback"
          ]
        },
        "affectedCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocalKey"
          },
          "description": "an array of at most 5000 item(s)",
          "title": "maxItems(5000)",
          "maxItems": 5000
        },
        "uncoveredCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocalKey"
          },
          "description": "an array of at most 5000 item(s)",
          "title": "maxItems(5000)",
          "maxItems": 5000
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "testRepository",
              "suite",
              "test",
              "capabilities",
              "outcome",
              "remainingExecution",
              "reasons"
            ],
            "properties": {
              "testRepository": {
                "$ref": "#/$defs/RepositoryReference"
              },
              "suite": {
                "type": "object",
                "required": [
                  "key",
                  "family",
                  "adapter"
                ],
                "properties": {
                  "key": {
                    "$ref": "#/$defs/LocalKey"
                  },
                  "family": {
                    "type": "string",
                    "enum": [
                      "functional-api"
                    ]
                  },
                  "adapter": {
                    "type": "string",
                    "description": "a string at most 127 character(s) long",
                    "title": "maxLength(127)",
                    "minLength": 1,
                    "maxLength": 127
                  }
                },
                "additionalProperties": false
              },
              "test": {
                "type": "object",
                "required": [
                  "key",
                  "name"
                ],
                "properties": {
                  "key": {
                    "$ref": "#/$defs/LocalKey"
                  },
                  "name": {
                    "type": "string",
                    "description": "a string at most 255 character(s) long",
                    "title": "maxLength(255)",
                    "minLength": 1,
                    "maxLength": 255
                  }
                },
                "additionalProperties": false
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/LocalKey"
                },
                "description": "an array of at most 5000 item(s)",
                "title": "maxItems(5000)",
                "minItems": 1,
                "maxItems": 5000
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "RUN_REQUIRED",
                  "SKIP_FOR_NOW"
                ]
              },
              "remainingExecution": {
                "type": "string",
                "enum": [
                  "none",
                  "full-suite"
                ]
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "code",
                    "capabilities"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "DIRECT_CAPABILITY_IMPACT",
                        "CONSERVATIVE_FALLBACK",
                        "NOT_AFFECTED_IN_EARLY_STAGE"
                      ]
                    },
                    "capabilities": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/LocalKey"
                      },
                      "description": "an array of at most 5000 item(s)",
                      "title": "maxItems(5000)",
                      "maxItems": 5000
                    }
                  },
                  "additionalProperties": false
                },
                "description": "an array of at least 1 item(s)",
                "title": "minItems(1)",
                "minItems": 1
              }
            },
            "additionalProperties": false
          },
          "description": "an array of at most 10000 item(s)",
          "title": "maxItems(10000)",
          "maxItems": 10000
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "a string at most 512 character(s) long",
            "title": "maxLength(512)",
            "minLength": 1,
            "maxLength": 512
          },
          "description": "an array of at most 100 item(s)",
          "title": "maxItems(100)",
          "maxItems": 100
        }
      },
      "additionalProperties": false,
      "description": "Deterministic functional API inclusion and omission decisions from immutable impact and catalog inputs.",
      "title": "Argus execution manifest v1"
    },
    "RepositoryReference": {
      "type": "object",
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "description": "a string matching the pattern ^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "description": "a string at most 255 character(s) long",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "description": "a string at most 255 character(s) long",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "description": "a string at most 255 character(s) long",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "Int": {
      "type": "integer",
      "description": "an integer",
      "title": "int"
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "algorithm",
            "digest"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "git-sha1"
              ]
            },
            "digest": {
              "type": "string",
              "description": "a string matching the pattern ^[0-9a-f]{40}$",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "algorithm",
            "digest"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "git-sha256"
              ]
            },
            "digest": {
              "type": "string",
              "description": "a string matching the pattern ^[0-9a-f]{64}$",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    },
    "DateTimeUtc": {
      "type": "string",
      "description": "a string to be decoded into a DateTime.Utc"
    },
    "CatalogSnapshotReference": {
      "type": "object",
      "required": [
        "sourceRepository",
        "revision",
        "descriptorApiVersion"
      ],
      "properties": {
        "sourceRepository": {
          "$ref": "#/$defs/RepositoryReference"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "descriptorApiVersion": {
          "type": "string",
          "enum": [
            "argus.dev/repository-descriptor/v1"
          ]
        }
      },
      "additionalProperties": false,
      "description": "The immutable repository descriptor observation queried by this result page."
    },
    "LocalKey": {
      "type": "string",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration.",
      "title": "maxLength(63)",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$"
    }
  },
  "$ref": "#/$defs/ExecutionManifestV1"
}
