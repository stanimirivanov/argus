{
  "$id": "https://argus.dev/contracts/execution-manifest/v2/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ExecutionManifestV2",
  "$defs": {
    "RepositoryReference": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha1"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha256"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    },
    "CatalogSnapshotReference": {
      "type": "object",
      "properties": {
        "sourceRepository": {
          "$ref": "#/$defs/RepositoryReference"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "descriptorApiVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/repository-descriptor/v1"
              ]
            }
          ]
        }
      },
      "required": [
        "sourceRepository",
        "revision",
        "descriptorApiVersion"
      ],
      "additionalProperties": false,
      "description": "The immutable repository descriptor observation queried by this result page."
    },
    "LocalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration."
    },
    "ExecutionManifestV2": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/execution-manifest/v2"
              ]
            }
          ]
        },
        "policyVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/selection-policy/functional-ui-capability/v1"
              ]
            }
          ]
        },
        "impact": {
          "type": "object",
          "properties": {
            "apiVersion": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "argus.dev/capability-impact/v1"
                  ]
                }
              ]
            },
            "analyzerVersion": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "argus-openapi/v1+libopenapi/v0.38.7"
                  ]
                }
              ]
            }
          },
          "required": [
            "apiVersion",
            "analyzerVersion"
          ],
          "additionalProperties": false
        },
        "change": {
          "type": "object",
          "properties": {
            "sourceRepository": {
              "$ref": "#/$defs/RepositoryReference"
            },
            "pullRequest": {
              "type": "object",
              "properties": {
                "number": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "number"
              ],
              "additionalProperties": false
            },
            "baseRevision": {
              "$ref": "#/$defs/Revision"
            },
            "headRevision": {
              "$ref": "#/$defs/Revision"
            },
            "observedAt": {
              "type": "string"
            },
            "trigger": {
              "type": "object",
              "properties": {
                "provider": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "github"
                      ]
                    }
                  ]
                },
                "deliveryId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "event": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "pull_request"
                      ]
                    }
                  ]
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "opened",
                    "reopened",
                    "synchronize",
                    "ready_for_review"
                  ]
                }
              },
              "required": [
                "provider",
                "deliveryId",
                "event",
                "action"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "sourceRepository",
            "pullRequest",
            "baseRevision",
            "headRevision",
            "observedAt",
            "trigger"
          ],
          "additionalProperties": false
        },
        "catalog": {
          "$ref": "#/$defs/CatalogSnapshotReference"
        },
        "family": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "functional-ui"
              ]
            }
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "targeted",
            "fallback"
          ]
        },
        "affectedCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocalKey"
          },
          "maxItems": 5000
        },
        "uncoveredCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocalKey"
          },
          "maxItems": 5000
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "testRepository": {
                "$ref": "#/$defs/RepositoryReference"
              },
              "suite": {
                "type": "object",
                "properties": {
                  "key": {
                    "$ref": "#/$defs/LocalKey"
                  },
                  "family": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "functional-ui"
                        ]
                      }
                    ]
                  },
                  "adapter": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 127
                  }
                },
                "required": [
                  "key",
                  "family",
                  "adapter"
                ],
                "additionalProperties": false
              },
              "test": {
                "type": "object",
                "properties": {
                  "key": {
                    "$ref": "#/$defs/LocalKey"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  }
                },
                "required": [
                  "key",
                  "name"
                ],
                "additionalProperties": false
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/LocalKey"
                },
                "minItems": 1,
                "maxItems": 5000
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "RUN_REQUIRED",
                  "SKIP_FOR_NOW"
                ]
              },
              "remainingExecution": {
                "type": "string",
                "enum": [
                  "none",
                  "full-suite"
                ]
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "DIRECT_CAPABILITY_IMPACT",
                        "CONSERVATIVE_FALLBACK",
                        "NOT_AFFECTED_IN_EARLY_STAGE"
                      ]
                    },
                    "capabilities": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/LocalKey"
                      },
                      "maxItems": 5000
                    }
                  },
                  "required": [
                    "code",
                    "capabilities"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "testRepository",
              "suite",
              "test",
              "capabilities",
              "outcome",
              "remainingExecution",
              "reasons"
            ],
            "additionalProperties": false
          },
          "maxItems": 10000
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "maxItems": 100
        }
      },
      "required": [
        "apiVersion",
        "policyVersion",
        "impact",
        "change",
        "catalog",
        "family",
        "mode",
        "affectedCapabilities",
        "uncoveredCapabilities",
        "decisions",
        "warnings"
      ],
      "additionalProperties": false,
      "title": "Argus browser capability selection manifest v2",
      "description": "Deterministic functional UI inclusion and omission decisions from immutable OpenAPI capability impact and catalog inputs."
    }
  }
}
