{
  "$id": "https://argus.dev/contracts/execution-attempt/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ExecutionAttemptV1": {
      "type": "object",
      "required": [
        "apiVersion",
        "attemptId",
        "manifest",
        "stage",
        "testRepository",
        "testRevision",
        "adapter",
        "startedAt",
        "completedAt",
        "outcome",
        "results",
        "artifacts"
      ],
      "properties": {
        "apiVersion": {
          "type": "string",
          "enum": [
            "argus.dev/execution-attempt/v1"
          ]
        },
        "attemptId": {
          "type": "string",
          "description": "a string matching the pattern ^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "maxLength(127)",
          "minLength": 1,
          "maxLength": 127,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "manifest": {
          "type": "object",
          "required": [
            "apiVersion",
            "sha256"
          ],
          "properties": {
            "apiVersion": {
              "type": "string",
              "enum": [
                "argus.dev/execution-manifest/v1"
              ]
            },
            "sha256": {
              "type": "string",
              "description": "a string matching the pattern ^[0-9a-f]{64}$",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "stage": {
          "type": "string",
          "enum": [
            "selected",
            "full-suite"
          ]
        },
        "testRepository": {
          "$ref": "#/$defs/RepositoryReference"
        },
        "testRevision": {
          "$ref": "#/$defs/Revision"
        },
        "adapter": {
          "type": "object",
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/LocalKey"
            },
            "version": {
              "type": "string",
              "description": "a string at most 127 character(s) long",
              "title": "maxLength(127)",
              "minLength": 1,
              "maxLength": 127
            }
          },
          "additionalProperties": false
        },
        "startedAt": {
          "$ref": "#/$defs/DateTimeUtc"
        },
        "completedAt": {
          "$ref": "#/$defs/DateTimeUtc"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "incomplete",
            "error"
          ]
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "suiteKey",
              "testKey",
              "outcome",
              "durationMs",
              "failure"
            ],
            "properties": {
              "suiteKey": {
                "$ref": "#/$defs/LocalKey"
              },
              "testKey": {
                "$ref": "#/$defs/LocalKey"
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "skipped",
                  "error"
                ]
              },
              "durationMs": {
                "$ref": "#/$defs/Int",
                "description": "a number less than or equal to 86400000",
                "title": "lessThanOrEqualTo(86400000)",
                "minimum": 0,
                "maximum": 86400000
              },
              "failure": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "code",
                      "message"
                    ],
                    "properties": {
                      "code": {
                        "$ref": "#/$defs/LocalKey"
                      },
                      "message": {
                        "type": "string",
                        "description": "a string at most 2000 character(s) long",
                        "title": "maxLength(2000)",
                        "minLength": 1,
                        "maxLength": 2000
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "description": "an array of at most 10000 item(s)",
          "title": "maxItems(10000)",
          "minItems": 1,
          "maxItems": 10000
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "kind",
              "uri",
              "sha256"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/LocalKey"
              },
              "kind": {
                "$ref": "#/$defs/LocalKey"
              },
              "uri": {
                "type": "string",
                "description": "a string at most 2048 character(s) long",
                "title": "maxLength(2048)",
                "minLength": 1,
                "maxLength": 2048
              },
              "sha256": {
                "type": "string",
                "description": "a string matching the pattern ^[0-9a-f]{64}$",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          },
          "description": "an array of at most 100 item(s)",
          "title": "maxItems(100)",
          "maxItems": 100
        }
      },
      "additionalProperties": false,
      "description": "Normalized functional API attempt correlated to an exact execution manifest and test revision.",
      "title": "Argus execution attempt v1"
    },
    "RepositoryReference": {
      "type": "object",
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "description": "a string matching the pattern ^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "description": "a string at most 255 character(s) long",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "description": "a string at most 255 character(s) long",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "description": "a string at most 255 character(s) long",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "algorithm",
            "digest"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "git-sha1"
              ]
            },
            "digest": {
              "type": "string",
              "description": "a string matching the pattern ^[0-9a-f]{40}$",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "algorithm",
            "digest"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "git-sha256"
              ]
            },
            "digest": {
              "type": "string",
              "description": "a string matching the pattern ^[0-9a-f]{64}$",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    },
    "LocalKey": {
      "type": "string",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration.",
      "title": "maxLength(63)",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "DateTimeUtc": {
      "type": "string",
      "description": "a string to be decoded into a DateTime.Utc"
    },
    "Int": {
      "type": "integer",
      "description": "an integer",
      "title": "int"
    }
  },
  "$ref": "#/$defs/ExecutionAttemptV1"
}
