{
  "$id": "https://argus.dev/contracts/execution-attempt/v2/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "argus.dev/execution-attempt/v2"
          ]
        }
      ]
    },
    "attemptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 127,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "manifest": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "enum": [
            "argus.dev/execution-manifest/v1",
            "argus.dev/execution-manifest/v4"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "apiVersion",
        "sha256"
      ],
      "additionalProperties": false
    },
    "stage": {
      "type": "string",
      "enum": [
        "relevant-now",
        "remaining-later",
        "shadow-control"
      ]
    },
    "testRepository": {
      "$ref": "#/$defs/RepositoryReference"
    },
    "testRevision": {
      "$ref": "#/$defs/Revision"
    },
    "adapter": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/LocalKey"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 127
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "startedAt": {
      "type": "string"
    },
    "completedAt": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "incomplete",
        "error"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "suiteKey": {
            "$ref": "#/$defs/LocalKey"
          },
          "testKey": {
            "$ref": "#/$defs/LocalKey"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped",
              "error"
            ]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400000
          },
          "failure": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "code": {
                    "$ref": "#/$defs/LocalKey"
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "code",
                  "message"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "suiteKey",
          "testKey",
          "outcome",
          "durationMs",
          "failure"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "$ref": "#/$defs/LocalKey"
          },
          "kind": {
            "$ref": "#/$defs/LocalKey"
          },
          "uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "key",
          "kind",
          "uri",
          "sha256"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "staging": {
      "type": "object",
      "properties": {
        "schedule": {
          "type": "object",
          "properties": {
            "apiVersion": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "argus.dev/predictive-portfolio/v1"
                  ]
                }
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "apiVersion",
            "sha256"
          ],
          "additionalProperties": false
        },
        "episodeId": {
          "$ref": "#/$defs/LocalKey"
        },
        "groupKey": {
          "$ref": "#/$defs/LocalKey"
        },
        "environment": {
          "$ref": "#/$defs/LocalKey"
        },
        "mode": {
          "type": "string",
          "enum": [
            "shadow",
            "staged"
          ]
        }
      },
      "required": [
        "schedule",
        "episodeId",
        "groupKey",
        "environment",
        "mode"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "attemptId",
    "manifest",
    "stage",
    "testRepository",
    "testRevision",
    "adapter",
    "startedAt",
    "completedAt",
    "outcome",
    "results",
    "artifacts",
    "staging"
  ],
  "additionalProperties": false,
  "$defs": {
    "RepositoryReference": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha1"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha256"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    },
    "LocalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration."
    }
  }
}
