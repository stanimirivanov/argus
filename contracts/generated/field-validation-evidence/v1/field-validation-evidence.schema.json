{
  "$id": "https://argus.dev/contracts/field-validation-evidence/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/FieldValidationEvidenceV1",
  "$defs": {
    "RepositoryReference": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha1"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha256"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    },
    "LocalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration."
    },
    "FieldValidationEvidenceV1": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/field-validation-evidence/v1"
              ]
            }
          ]
        },
        "policyVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/validation-policy/functional-api-compatible-field-rename/v1"
              ]
            }
          ]
        },
        "validationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "proposalId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "proposalPolicyVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/adaptation-policy/functional-api-compatible-field-rename/v1"
              ]
            }
          ]
        },
        "test": {
          "type": "object",
          "properties": {
            "repository": {
              "$ref": "#/$defs/RepositoryReference"
            },
            "revision": {
              "$ref": "#/$defs/Revision"
            },
            "suiteKey": {
              "$ref": "#/$defs/LocalKey"
            },
            "testKey": {
              "$ref": "#/$defs/LocalKey"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "adapter": {
              "$ref": "#/$defs/LocalKey"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/LocalKey"
              },
              "minItems": 1,
              "maxItems": 5000
            }
          },
          "required": [
            "repository",
            "revision",
            "suiteKey",
            "testKey",
            "name",
            "adapter",
            "capabilities"
          ],
          "additionalProperties": false
        },
        "adapter": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/LocalKey"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 127
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        "edit": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^/\\\\][^\\\\]*$"
            },
            "beforeSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "startByte": {
              "type": "integer",
              "minimum": 0
            },
            "endByte": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "original": {
              "type": "string",
              "pattern": "^[A-Za-z_$][A-Za-z0-9_$]{0,254}$"
            },
            "replacement": {
              "type": "string",
              "pattern": "^[A-Za-z_$][A-Za-z0-9_$]{0,254}$"
            },
            "semanticRole": {
              "type": "string",
              "enum": [
                "request-body-key",
                "response-field-access"
              ]
            }
          },
          "required": [
            "path",
            "beforeSha256",
            "startByte",
            "endByte",
            "original",
            "replacement",
            "semanticRole"
          ],
          "additionalProperties": false
        },
        "source": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "originalSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "candidateSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "negativeSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "restoredSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "negativeControlField": {
              "type": "string",
              "pattern": "^__argus_negative_field_[0-9a-f]{12}$"
            }
          },
          "required": [
            "path",
            "originalSha256",
            "candidateSha256",
            "negativeSha256",
            "restoredSha256",
            "negativeControlField"
          ],
          "additionalProperties": false
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "phase": {
                "type": "string",
                "enum": [
                  "original",
                  "candidate",
                  "negative-control"
                ]
              },
              "repeat": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2
              },
              "sourceSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "startedAt": {
                "type": "string"
              },
              "completedAt": {
                "type": "string"
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed"
                ]
              },
              "failure": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "code": {
                        "$ref": "#/$defs/LocalKey"
                      },
                      "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      }
                    },
                    "required": [
                      "code",
                      "message"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "phase",
              "repeat",
              "sourceSha256",
              "startedAt",
              "completedAt",
              "outcome",
              "failure"
            ],
            "additionalProperties": false
          },
          "minItems": 6,
          "maxItems": 6
        }
      },
      "required": [
        "apiVersion",
        "policyVersion",
        "validationId",
        "proposalId",
        "proposalPolicyVersion",
        "test",
        "adapter",
        "edit",
        "source",
        "runs"
      ],
      "additionalProperties": false
    }
  }
}
