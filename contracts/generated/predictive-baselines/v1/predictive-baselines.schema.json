{
  "$id": "https://argus.dev/contracts/predictive-baselines/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PredictiveBaselinesV1",
  "$defs": {
    "LocalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration."
    },
    "PredictiveBaselinesV1": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/predictive-baselines/v1"
              ]
            }
          ]
        },
        "budgetMs": {
          "type": "integer",
          "maximum": 86400000,
          "exclusiveMinimum": 0
        },
        "seed": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "holdoutStart": {
          "type": "string"
        },
        "holdoutEnd": {
          "type": "string"
        },
        "episodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/LocalKey"
              },
              "comparisons": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "enum": [
                        "run-all",
                        "explicit-impact",
                        "recent-failure",
                        "duration",
                        "seeded-random"
                      ]
                    },
                    "selectedTestIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "maxItems": 10000
                    },
                    "estimatedSelectedDurationMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 864000000000
                    },
                    "actualSelectedDurationMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 864000000000
                    },
                    "fullDurationMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 864000000000
                    },
                    "fullTestCount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "fullFailureCount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "selectedFailureCount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "missedFailureCount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "timeToFirstFailureMs": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 864000000000
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "selectedTestIds",
                    "estimatedSelectedDurationMs",
                    "actualSelectedDurationMs",
                    "fullDurationMs",
                    "fullTestCount",
                    "fullFailureCount",
                    "selectedFailureCount",
                    "missedFailureCount",
                    "timeToFirstFailureMs"
                  ],
                  "additionalProperties": false
                },
                "minItems": 5,
                "maxItems": 5
              }
            },
            "required": [
              "id",
              "comparisons"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 1000
        }
      },
      "required": [
        "apiVersion",
        "budgetMs",
        "seed",
        "holdoutStart",
        "holdoutEnd",
        "episodes"
      ],
      "additionalProperties": false,
      "title": "Argus predictive baseline comparison v1"
    }
  }
}
