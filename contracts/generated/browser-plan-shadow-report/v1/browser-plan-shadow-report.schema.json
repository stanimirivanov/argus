{
  "$id": "https://argus.dev/contracts/browser-plan-shadow-report/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/BrowserPlanShadowReportV1",
  "$defs": {
    "LocalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration."
    },
    "RepositoryReference": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha1"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha256"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    },
    "BrowserPlanShadowReportV1": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/browser-plan-shadow-report/v1"
              ]
            }
          ]
        },
        "plan": {
          "type": "object",
          "properties": {
            "apiVersion": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "argus.dev/browser-execution-plan/v1"
                  ]
                }
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "apiVersion",
            "sha256"
          ],
          "additionalProperties": false
        },
        "manifest": {
          "type": "object",
          "properties": {
            "apiVersion": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "argus.dev/browser-selection-manifest/v1"
                  ]
                }
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "apiVersion",
            "sha256"
          ],
          "additionalProperties": false
        },
        "groupCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "groupsWithSelection": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "fullOnlyGroupCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "selectedTestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "fullSuiteTestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "selectedDurationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 864000000000
        },
        "fullSuiteDurationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 864000000000
        },
        "durationReductionMs": {
          "type": "integer",
          "minimum": -864000000000,
          "maximum": 864000000000
        },
        "selectedFailureCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "fullSuiteFailureCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "caughtFullSuiteFailureCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "failureRecallBasisPoints": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "groupKey": {
                "$ref": "#/$defs/LocalKey"
              },
              "testRepository": {
                "$ref": "#/$defs/RepositoryReference"
              },
              "testRevision": {
                "$ref": "#/$defs/Revision"
              },
              "adapter": {
                "$ref": "#/$defs/LocalKey"
              },
              "project": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z][a-z0-9._-]*$"
              },
              "environment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z][a-z0-9._-]*$"
              },
              "adapterVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 127
              },
              "selectedAttemptId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 127,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "fullSuiteAttemptId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 127,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "selectedTestCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "fullSuiteTestCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "selectedDurationMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 864000000000
              },
              "fullSuiteDurationMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 864000000000
              },
              "durationReductionMs": {
                "type": "integer",
                "minimum": -864000000000,
                "maximum": 864000000000
              },
              "selectedFailureCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "fullSuiteFailureCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "caughtFullSuiteFailureCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "failureRecallBasisPoints": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "missedFailures": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "suiteKey": {
                      "$ref": "#/$defs/LocalKey"
                    },
                    "testKey": {
                      "$ref": "#/$defs/LocalKey"
                    },
                    "fullSuiteOutcome": {
                      "type": "string",
                      "enum": [
                        "failed",
                        "error"
                      ]
                    },
                    "selectedOutcome": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "passed",
                            "failed",
                            "skipped",
                            "error"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "enum": [
                        "not-selected",
                        "not-reproduced"
                      ]
                    }
                  },
                  "required": [
                    "suiteKey",
                    "testKey",
                    "fullSuiteOutcome",
                    "selectedOutcome",
                    "reason"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 10000
              }
            },
            "required": [
              "groupKey",
              "testRepository",
              "testRevision",
              "adapter",
              "project",
              "environment",
              "adapterVersion",
              "selectedAttemptId",
              "fullSuiteAttemptId",
              "selectedTestCount",
              "fullSuiteTestCount",
              "selectedDurationMs",
              "fullSuiteDurationMs",
              "durationReductionMs",
              "selectedFailureCount",
              "fullSuiteFailureCount",
              "caughtFullSuiteFailureCount",
              "failureRecallBasisPoints",
              "missedFailures"
            ],
            "additionalProperties": false
          },
          "maxItems": 10000
        }
      },
      "required": [
        "apiVersion",
        "plan",
        "manifest",
        "groupCount",
        "groupsWithSelection",
        "fullOnlyGroupCount",
        "selectedTestCount",
        "fullSuiteTestCount",
        "selectedDurationMs",
        "fullSuiteDurationMs",
        "durationReductionMs",
        "selectedFailureCount",
        "fullSuiteFailureCount",
        "caughtFullSuiteFailureCount",
        "failureRecallBasisPoints",
        "groups"
      ],
      "additionalProperties": false,
      "description": "Complete browser selection miss and failure recall evidence."
    }
  }
}
