{
  "$id": "https://argus.dev/contracts/review-outcome/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ReviewOutcomeV1",
  "$defs": {
    "RepositoryReference": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "LocalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration."
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha1"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha256"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    },
    "ReviewOutcomeV1": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/review-outcome/v1"
              ]
            }
          ]
        },
        "outcomeId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "proposalId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "validationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "repository": {
          "$ref": "#/$defs/RepositoryReference"
        },
        "pullRequest": {
          "type": "object",
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "required": [
            "number",
            "url"
          ],
          "additionalProperties": false
        },
        "decision": {
          "type": "string",
          "enum": [
            "accepted-as-proposed",
            "accepted-with-edits",
            "rejected"
          ]
        },
        "reason": {
          "type": "object",
          "properties": {
            "code": {
              "$ref": "#/$defs/LocalKey"
            },
            "note": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "code",
            "note"
          ],
          "additionalProperties": false
        },
        "generatedRevision": {
          "$ref": "#/$defs/Revision"
        },
        "finalRevision": {
          "$ref": "#/$defs/Revision"
        },
        "closedAt": {
          "type": "string"
        },
        "mergedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedAt": {
          "type": "string"
        },
        "reviewerEdits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[^/\\\\][^\\\\]*$"
              },
              "previousPath": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "^[^/\\\\][^\\\\]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "kind": {
                "type": "string",
                "enum": [
                  "added",
                  "modified",
                  "deleted",
                  "renamed",
                  "copied"
                ]
              },
              "additions": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "deletions": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "patch": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              }
            },
            "required": [
              "path",
              "previousPath",
              "kind",
              "additions",
              "deletions",
              "patch"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        }
      },
      "required": [
        "apiVersion",
        "outcomeId",
        "reviewId",
        "proposalId",
        "validationId",
        "repository",
        "pullRequest",
        "decision",
        "reason",
        "generatedRevision",
        "finalRevision",
        "closedAt",
        "mergedAt",
        "observedAt",
        "reviewerEdits"
      ],
      "additionalProperties": false,
      "title": "Argus review outcome v1",
      "description": "Terminal provider-derived review disposition, explicit reason, and complete bounded diff after Argus' generated commit."
    }
  }
}
