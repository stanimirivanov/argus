{
  "$id": "https://argus.dev/contracts/functional-api-repair-validation-request/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/FunctionalAPIRepairValidationRequestV1",
  "$defs": {
    "RepositoryReference": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha1"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha256"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    },
    "LocalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration."
    },
    "FunctionalAPIRepairValidationRequestV1": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/functional-api-repair-validation-request/v1"
              ]
            }
          ]
        },
        "validationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "proposalId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "phase": {
          "type": "string",
          "enum": [
            "original",
            "candidate",
            "negative-control"
          ]
        },
        "test": {
          "type": "object",
          "properties": {
            "repository": {
              "$ref": "#/$defs/RepositoryReference"
            },
            "revision": {
              "$ref": "#/$defs/Revision"
            },
            "suiteKey": {
              "$ref": "#/$defs/LocalKey"
            },
            "testKey": {
              "$ref": "#/$defs/LocalKey"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "adapter": {
              "$ref": "#/$defs/LocalKey"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/LocalKey"
              },
              "minItems": 1,
              "maxItems": 5000
            }
          },
          "required": [
            "repository",
            "revision",
            "suiteKey",
            "testKey",
            "name",
            "adapter",
            "capabilities"
          ],
          "additionalProperties": false
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "apiVersion",
        "validationId",
        "proposalId",
        "phase",
        "test",
        "sourceSha256"
      ],
      "additionalProperties": false,
      "title": "Argus functional API repair validation request v1",
      "description": "One exact test and disposable-workspace phase supplied to a reviewed validation adapter."
    }
  }
}
