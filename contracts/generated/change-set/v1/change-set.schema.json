{
  "$id": "https://argus.dev/contracts/change-set/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ChangeSetV1",
  "$defs": {
    "RepositoryReference": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha1"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha256"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    },
    "ChangeFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^/\\\\][^\\\\]*$"
        },
        "previousPath": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^/\\\\][^\\\\]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "added",
            "modified",
            "deleted",
            "renamed",
            "copied"
          ]
        },
        "additions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deletions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "patch": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 65536
            },
            {
              "type": "null"
            }
          ]
        },
        "patchStatus": {
          "type": "string",
          "enum": [
            "complete",
            "unavailable",
            "truncated",
            "budget-exhausted"
          ]
        }
      },
      "required": [
        "path",
        "previousPath",
        "kind",
        "additions",
        "deletions",
        "patch",
        "patchStatus"
      ],
      "additionalProperties": false,
      "description": "One normalized repository-relative file change. Patch status distinguishes missing evidence from bounded evidence."
    },
    "ChangeSetV1": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/change-set/v1"
              ]
            }
          ]
        },
        "sourceRepository": {
          "$ref": "#/$defs/RepositoryReference"
        },
        "pullRequest": {
          "type": "object",
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "number"
          ],
          "additionalProperties": false
        },
        "baseRevision": {
          "$ref": "#/$defs/Revision"
        },
        "headRevision": {
          "$ref": "#/$defs/Revision"
        },
        "observedAt": {
          "type": "string"
        },
        "trigger": {
          "type": "object",
          "properties": {
            "provider": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "github"
                  ]
                }
              ]
            },
            "deliveryId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "event": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "pull_request"
                  ]
                }
              ]
            },
            "action": {
              "type": "string",
              "enum": [
                "opened",
                "reopened",
                "synchronize",
                "ready_for_review"
              ]
            }
          },
          "required": [
            "provider",
            "deliveryId",
            "event",
            "action"
          ],
          "additionalProperties": false
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChangeFile"
          },
          "maxItems": 1000
        },
        "filesTruncated": {
          "type": "boolean"
        }
      },
      "required": [
        "apiVersion",
        "sourceRepository",
        "pullRequest",
        "baseRevision",
        "headRevision",
        "observedAt",
        "trigger",
        "files",
        "filesTruncated"
      ],
      "additionalProperties": false,
      "title": "Argus change set v1",
      "description": "A reproducible, bounded pull-request change observation at immutable base and head revisions."
    }
  }
}
