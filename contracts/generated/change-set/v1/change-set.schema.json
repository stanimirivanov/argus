{
  "$id": "https://argus.dev/contracts/change-set/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ChangeSetV1": {
      "type": "object",
      "required": [
        "apiVersion",
        "sourceRepository",
        "pullRequest",
        "baseRevision",
        "headRevision",
        "observedAt",
        "trigger",
        "files",
        "filesTruncated"
      ],
      "properties": {
        "apiVersion": {
          "type": "string",
          "enum": [
            "argus.dev/change-set/v1"
          ]
        },
        "sourceRepository": {
          "$ref": "#/$defs/RepositoryReference"
        },
        "pullRequest": {
          "type": "object",
          "required": [
            "number"
          ],
          "properties": {
            "number": {
              "$ref": "#/$defs/Int",
              "description": "a number greater than or equal to 1",
              "title": "greaterThanOrEqualTo(1)",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "baseRevision": {
          "$ref": "#/$defs/Revision"
        },
        "headRevision": {
          "$ref": "#/$defs/Revision"
        },
        "observedAt": {
          "$ref": "#/$defs/DateTimeUtc"
        },
        "trigger": {
          "type": "object",
          "required": [
            "provider",
            "deliveryId",
            "event",
            "action"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "github"
              ]
            },
            "deliveryId": {
              "type": "string",
              "description": "a string at most 255 character(s) long",
              "title": "maxLength(255)",
              "minLength": 1,
              "maxLength": 255
            },
            "event": {
              "type": "string",
              "enum": [
                "pull_request"
              ]
            },
            "action": {
              "type": "string",
              "enum": [
                "opened",
                "reopened",
                "synchronize",
                "ready_for_review"
              ]
            }
          },
          "additionalProperties": false
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChangeFile"
          },
          "description": "an array of at most 1000 item(s)",
          "title": "maxItems(1000)",
          "maxItems": 1000
        },
        "filesTruncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "description": "A reproducible, bounded pull-request change observation at immutable base and head revisions.",
      "title": "Argus change set v1"
    },
    "RepositoryReference": {
      "type": "object",
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "description": "a string matching the pattern ^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "description": "a string at most 255 character(s) long",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "description": "a string at most 255 character(s) long",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "description": "a string at most 255 character(s) long",
          "title": "maxLength(255)",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "Int": {
      "type": "integer",
      "description": "an integer",
      "title": "int"
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "algorithm",
            "digest"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "git-sha1"
              ]
            },
            "digest": {
              "type": "string",
              "description": "a string matching the pattern ^[0-9a-f]{40}$",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "algorithm",
            "digest"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "git-sha256"
              ]
            },
            "digest": {
              "type": "string",
              "description": "a string matching the pattern ^[0-9a-f]{64}$",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    },
    "DateTimeUtc": {
      "type": "string",
      "description": "a string to be decoded into a DateTime.Utc"
    },
    "ChangeFile": {
      "type": "object",
      "required": [
        "path",
        "previousPath",
        "kind",
        "additions",
        "deletions",
        "patch",
        "patchStatus"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "a string matching the pattern ^[^/\\\\][^\\\\]*$",
          "title": "maxLength(4096)",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^/\\\\][^\\\\]*$"
        },
        "previousPath": {
          "anyOf": [
            {
              "type": "string",
              "description": "a string matching the pattern ^[^/\\\\][^\\\\]*$",
              "title": "maxLength(4096)",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^/\\\\][^\\\\]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "added",
            "modified",
            "deleted",
            "renamed",
            "copied"
          ]
        },
        "additions": {
          "$ref": "#/$defs/Int",
          "description": "a non-negative number",
          "title": "greaterThanOrEqualTo(0)",
          "minimum": 0
        },
        "deletions": {
          "$ref": "#/$defs/Int",
          "description": "a non-negative number",
          "title": "greaterThanOrEqualTo(0)",
          "minimum": 0
        },
        "patch": {
          "anyOf": [
            {
              "type": "string",
              "description": "a string at most 65536 character(s) long",
              "title": "maxLength(65536)",
              "maxLength": 65536
            },
            {
              "type": "null"
            }
          ]
        },
        "patchStatus": {
          "type": "string",
          "enum": [
            "complete",
            "unavailable",
            "truncated",
            "budget-exhausted"
          ]
        }
      },
      "additionalProperties": false,
      "description": "One normalized repository-relative file change. Patch status distinguishes missing evidence from bounded evidence."
    }
  },
  "$ref": "#/$defs/ChangeSetV1"
}
