{
  "$id": "https://argus.dev/contracts/repository-descriptor/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/RepositoryDescriptorV1",
  "$defs": {
    "RepositoryReference": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "LocalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration."
    },
    "CapabilityDeclaration": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/LocalKey"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "key",
        "name"
      ],
      "additionalProperties": false
    },
    "ComponentDeclaration": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/LocalKey"
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocalKey"
          },
          "minItems": 1
        }
      },
      "required": [
        "key",
        "root",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "TestFamily": {
      "type": "string",
      "enum": [
        "unit",
        "component",
        "contract",
        "integration",
        "functional-api",
        "functional-ui",
        "end-to-end",
        "performance",
        "security",
        "resilience",
        "other"
      ]
    },
    "TestDeclaration": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/LocalKey"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocalKey"
          },
          "minItems": 1
        }
      },
      "required": [
        "key",
        "name",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "TestSuiteDeclaration": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/LocalKey"
        },
        "repository": {
          "$ref": "#/$defs/RepositoryReference"
        },
        "family": {
          "$ref": "#/$defs/TestFamily"
        },
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 127
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TestDeclaration"
          },
          "minItems": 1
        }
      },
      "required": [
        "key",
        "repository",
        "family",
        "adapter",
        "tests"
      ],
      "additionalProperties": false
    },
    "RepositoryDescriptorV1": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/repository-descriptor/v1"
              ]
            }
          ]
        },
        "repository": {
          "$ref": "#/$defs/RepositoryReference"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityDeclaration"
          },
          "minItems": 1
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentDeclaration"
          },
          "minItems": 1
        },
        "testSuites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TestSuiteDeclaration"
          }
        }
      },
      "required": [
        "apiVersion",
        "repository",
        "capabilities",
        "components",
        "testSuites"
      ],
      "additionalProperties": false,
      "title": "Argus repository descriptor v1",
      "description": "Declares repository-scoped capabilities, components, test suites, stable tests, and explicit mappings."
    }
  }
}
