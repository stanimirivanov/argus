{
  "$id": "https://argus.dev/contracts/predictive-calibration/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PredictiveCalibrationV1",
  "$defs": {
    "LocalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration."
    },
    "PredictiveCalibrationV1": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/predictive-calibration/v1"
              ]
            }
          ]
        },
        "holdoutStart": {
          "type": "string"
        },
        "holdoutEnd": {
          "type": "string"
        },
        "calibrationEpochs": {
          "type": "integer",
          "maximum": 9007199254740991,
          "exclusiveMinimum": 0
        },
        "learningRate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": [
                "Infinity",
                "-Infinity",
                "NaN"
              ]
            }
          ]
        },
        "l2Penalty": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": [
                "Infinity",
                "-Infinity",
                "NaN"
              ]
            }
          ]
        },
        "minimumExamples": {
          "type": "integer",
          "maximum": 9007199254740991,
          "exclusiveMinimum": 0
        },
        "minimumFailures": {
          "type": "integer",
          "maximum": 9007199254740991,
          "exclusiveMinimum": 0
        },
        "fitEpisodeIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocalKey"
          },
          "minItems": 2,
          "maxItems": 1000
        },
        "calibrationEpisodeIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocalKey"
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "model": {
          "type": "object",
          "properties": {
            "trainingExamples": {
              "type": "integer",
              "maximum": 9007199254740991,
              "exclusiveMinimum": 0
            },
            "trainingFailures": {
              "type": "integer",
              "maximum": 9007199254740991,
              "exclusiveMinimum": 0
            },
            "epochs": {
              "type": "integer",
              "maximum": 9007199254740991,
              "exclusiveMinimum": 0
            },
            "learningRate": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "enum": [
                    "Infinity",
                    "-Infinity",
                    "NaN"
                  ]
                }
              ]
            },
            "l2Penalty": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "enum": [
                    "Infinity",
                    "-Infinity",
                    "NaN"
                  ]
                }
              ]
            },
            "intercept": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "enum": [
                    "Infinity",
                    "-Infinity",
                    "NaN"
                  ]
                }
              ]
            },
            "coefficients": {
              "type": "object",
              "properties": {
                "explicitImpact": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "enum": [
                        "Infinity",
                        "-Infinity",
                        "NaN"
                      ]
                    }
                  ]
                },
                "priorFailureRate": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "enum": [
                        "Infinity",
                        "-Infinity",
                        "NaN"
                      ]
                    }
                  ]
                },
                "priorSeen": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "enum": [
                        "Infinity",
                        "-Infinity",
                        "NaN"
                      ]
                    }
                  ]
                },
                "recentFailure": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "enum": [
                        "Infinity",
                        "-Infinity",
                        "NaN"
                      ]
                    }
                  ]
                }
              },
              "required": [
                "explicitImpact",
                "priorFailureRate",
                "priorSeen",
                "recentFailure"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "trainingExamples",
            "trainingFailures",
            "epochs",
            "learningRate",
            "l2Penalty",
            "intercept",
            "coefficients"
          ],
          "additionalProperties": false
        },
        "globalCurve": {
          "type": "object",
          "properties": {
            "examples": {
              "type": "integer",
              "maximum": 9007199254740991,
              "exclusiveMinimum": 0
            },
            "failures": {
              "type": "integer",
              "maximum": 9007199254740991,
              "exclusiveMinimum": 0
            },
            "intercept": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "enum": [
                    "Infinity",
                    "-Infinity",
                    "NaN"
                  ]
                }
              ]
            },
            "slope": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "enum": [
                    "Infinity",
                    "-Infinity",
                    "NaN"
                  ]
                }
              ]
            }
          },
          "required": [
            "examples",
            "failures",
            "intercept",
            "slope"
          ],
          "additionalProperties": false
        },
        "cohorts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repositoryKey": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "family": {
                "type": "string",
                "enum": [
                  "functional-api",
                  "functional-ui"
                ]
              },
              "examples": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "failures": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "source": {
                "type": "string",
                "enum": [
                  "cohort",
                  "global"
                ]
              },
              "curve": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "examples": {
                        "type": "integer",
                        "maximum": 9007199254740991,
                        "exclusiveMinimum": 0
                      },
                      "failures": {
                        "type": "integer",
                        "maximum": 9007199254740991,
                        "exclusiveMinimum": 0
                      },
                      "intercept": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "string",
                            "enum": [
                              "Infinity",
                              "-Infinity",
                              "NaN"
                            ]
                          }
                        ]
                      },
                      "slope": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "string",
                            "enum": [
                              "Infinity",
                              "-Infinity",
                              "NaN"
                            ]
                          }
                        ]
                      }
                    },
                    "required": [
                      "examples",
                      "failures",
                      "intercept",
                      "slope"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "repositoryKey",
              "family",
              "examples",
              "failures",
              "source",
              "curve"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        },
        "episodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/LocalKey"
              },
              "predictions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "repositoryKey": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "family": {
                      "type": "string",
                      "enum": [
                        "functional-api",
                        "functional-ui"
                      ]
                    },
                    "riskScore": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "enum": [
                            "Infinity",
                            "-Infinity",
                            "NaN"
                          ]
                        }
                      ]
                    },
                    "rawProbability": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "enum": [
                            "Infinity",
                            "-Infinity",
                            "NaN"
                          ]
                        }
                      ]
                    },
                    "probability": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "enum": [
                            "Infinity",
                            "-Infinity",
                            "NaN"
                          ]
                        }
                      ]
                    },
                    "source": {
                      "type": "string",
                      "enum": [
                        "cohort",
                        "global"
                      ]
                    },
                    "failed": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "repositoryKey",
                    "family",
                    "riskScore",
                    "rawProbability",
                    "probability",
                    "source",
                    "failed"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 10000
              }
            },
            "required": [
              "id",
              "predictions"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "quality": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repositoryKey": {
                "type": "string"
              },
              "family": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "maximum": 9007199254740991,
                "exclusiveMinimum": 0
              },
              "failures": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "rawBrier": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "Infinity",
                      "-Infinity",
                      "NaN"
                    ]
                  }
                ]
              },
              "calibratedBrier": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "Infinity",
                      "-Infinity",
                      "NaN"
                    ]
                  }
                ]
              },
              "expectedError": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "Infinity",
                      "-Infinity",
                      "NaN"
                    ]
                  }
                ]
              },
              "reliabilityBins": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "lower": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "enum": [
                            "Infinity",
                            "-Infinity",
                            "NaN"
                          ]
                        }
                      ]
                    },
                    "upper": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "enum": [
                            "Infinity",
                            "-Infinity",
                            "NaN"
                          ]
                        }
                      ]
                    },
                    "count": {
                      "type": "integer",
                      "maximum": 9007199254740991,
                      "exclusiveMinimum": 0
                    },
                    "failures": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "meanProbability": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "enum": [
                            "Infinity",
                            "-Infinity",
                            "NaN"
                          ]
                        }
                      ]
                    },
                    "observedRate": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "enum": [
                            "Infinity",
                            "-Infinity",
                            "NaN"
                          ]
                        }
                      ]
                    }
                  },
                  "required": [
                    "lower",
                    "upper",
                    "count",
                    "failures",
                    "meanProbability",
                    "observedRate"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 10
              }
            },
            "required": [
              "repositoryKey",
              "family",
              "count",
              "failures",
              "rawBrier",
              "calibratedBrier",
              "expectedError",
              "reliabilityBins"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 100001
        }
      },
      "required": [
        "apiVersion",
        "holdoutStart",
        "holdoutEnd",
        "calibrationEpochs",
        "learningRate",
        "l2Penalty",
        "minimumExamples",
        "minimumFailures",
        "fitEpisodeIds",
        "calibrationEpisodeIds",
        "model",
        "globalCurve",
        "cohorts",
        "episodes",
        "quality"
      ],
      "additionalProperties": false,
      "title": "Argus predictive calibration evaluation v1"
    }
  }
}
