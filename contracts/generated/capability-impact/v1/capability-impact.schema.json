{
  "$id": "https://argus.dev/contracts/capability-impact/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CapabilityImpactV1",
  "$defs": {
    "RepositoryReference": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops",
            "other"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "providerRepositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "provider",
        "host",
        "providerRepositoryId",
        "owner",
        "name"
      ],
      "additionalProperties": false,
      "description": "A repository reference anchored by the provider-assigned identity; owner and name are mutable display coordinates."
    },
    "Revision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha1"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "git-sha256"
                  ]
                }
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        }
      ],
      "description": "An immutable, normalized Git object revision."
    },
    "LocalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "description": "A stable, repository-declared key. It is scoped by its containing repository or parent declaration."
    },
    "OperationImpact": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "PUT",
            "POST",
            "DELETE",
            "OPTIONS",
            "HEAD",
            "PATCH",
            "TRACE",
            "QUERY"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^\\/"
        },
        "operationId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "added",
            "modified",
            "removed"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocalKey"
          },
          "maxItems": 50
        },
        "potentiallyBreaking": {
          "type": "boolean"
        }
      },
      "required": [
        "method",
        "path",
        "operationId",
        "kind",
        "capabilities",
        "potentiallyBreaking"
      ],
      "additionalProperties": false,
      "description": "A semantically changed HTTP operation and its explicit repository-scoped capability mappings."
    },
    "OpenAPIDocumentImpact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "previousPath": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "added",
            "modified",
            "removed"
          ]
        },
        "totalChanges": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "breakingChanges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OperationImpact"
          },
          "maxItems": 5000
        }
      },
      "required": [
        "path",
        "previousPath",
        "kind",
        "totalChanges",
        "breakingChanges",
        "operations"
      ],
      "additionalProperties": false,
      "description": "Semantic summary and operation evidence for one changed OpenAPI document."
    },
    "CapabilityImpactV1": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus.dev/capability-impact/v1"
              ]
            }
          ]
        },
        "analyzerVersion": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "argus-openapi/v1+libopenapi/v0.38.7"
              ]
            }
          ]
        },
        "sourceRepository": {
          "$ref": "#/$defs/RepositoryReference"
        },
        "pullRequest": {
          "type": "object",
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "number"
          ],
          "additionalProperties": false
        },
        "baseRevision": {
          "$ref": "#/$defs/Revision"
        },
        "headRevision": {
          "$ref": "#/$defs/Revision"
        },
        "observedAt": {
          "type": "string"
        },
        "trigger": {
          "type": "object",
          "properties": {
            "provider": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "github"
                  ]
                }
              ]
            },
            "deliveryId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "event": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "pull_request"
                  ]
                }
              ]
            },
            "action": {
              "type": "string",
              "enum": [
                "opened",
                "reopened",
                "synchronize",
                "ready_for_review"
              ]
            }
          },
          "required": [
            "provider",
            "deliveryId",
            "event",
            "action"
          ],
          "additionalProperties": false
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "partial"
          ]
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpenAPIDocumentImpact"
          },
          "maxItems": 50
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "maxItems": 100
        }
      },
      "required": [
        "apiVersion",
        "analyzerVersion",
        "sourceRepository",
        "pullRequest",
        "baseRevision",
        "headRevision",
        "observedAt",
        "trigger",
        "status",
        "documents",
        "warnings"
      ],
      "additionalProperties": false,
      "title": "Argus capability impact v1",
      "description": "Explainable capability impact derived from semantic OpenAPI changes at immutable revisions."
    }
  }
}
