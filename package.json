{
  "name": "argus-contract-tooling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "contracts:generate": "tsx contracts/scripts/generate.ts",
    "contracts:check": "tsx contracts/scripts/generate.ts --check",
    "format": "biome check --write contracts/source contracts/scripts contracts/fixtures package.json tsconfig.json biome.json",
    "format:check": "biome check contracts/source contracts/scripts contracts/fixtures package.json tsconfig.json biome.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test contracts/source/repository-descriptor-v1.test.ts",
    "licenses:check": "tsx contracts/scripts/check-licenses.ts"
  },
  "dependencies": {
    "effect": "3.22.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "26.5.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
