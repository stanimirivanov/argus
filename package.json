{
  "name": "argus-contract-tooling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "contracts:generate": "tsx contracts/scripts/generate.ts",
    "contracts:check": "tsx contracts/scripts/generate.ts --check",
    "format": "biome check --write contracts/source contracts/scripts contracts/fixtures examples/functional-api examples/functional-ui package.json tsconfig.json biome.json",
    "format:check": "biome check contracts/source contracts/scripts contracts/fixtures examples/functional-api examples/functional-ui package.json tsconfig.json biome.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test contracts/source/*.test.ts",
    "api-validate": "node examples/functional-api/validate.mjs && node examples/functional-api/field-proposal-validate.mjs",
    "licenses:check": "tsx contracts/scripts/check-licenses.ts"
  },
  "dependencies": {
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "24.12.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
